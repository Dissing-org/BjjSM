FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Shared/BjjSM.SharedKernel/*.csproj src/Shared/BjjSM.SharedKernel/
COPY src/Modules/Memberships/BjjSM.Modules.Memberships.Domain/*.csproj src/Modules/Memberships/BjjSM.Modules.Memberships.Domain/
COPY src/Modules/Curriculum/BjjSM.Modules.Curriculum.Domain/*.csproj src/Modules/Curriculum/BjjSM.Modules.Curriculum.Domain/
COPY src/Apps/BjjSM.Client/*.csproj src/Apps/BjjSM.Client/

RUN dotnet restore src/Apps/BjjSM.Client/BjjSM.Client.csproj

COPY src/Shared/ src/Shared/
COPY src/Modules/Memberships/BjjSM.Modules.Memberships.Domain/ src/Modules/Memberships/BjjSM.Modules.Memberships.Domain/
COPY src/Modules/Curriculum/BjjSM.Modules.Curriculum.Domain/ src/Modules/Curriculum/BjjSM.Modules.Curriculum.Domain/
COPY src/Apps/BjjSM.Client/ src/Apps/BjjSM.Client/

RUN dotnet publish src/Apps/BjjSM.Client/BjjSM.Client.csproj -c Release -o /app/publish

FROM nginx:alpine AS runtime
WORKDIR /usr/share/nginx/html

RUN rm -rf ./*
COPY --from=build /app/publish/wwwroot/ .
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
