@page "/curriculum"
@using System.Globalization
@inject ICurriculumApiClient CurriculumApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Læseplan | BjjSM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold text-dark m-0"><span aria-hidden="true">📅</span> Akademiets læseplan</h1>
        <p class="text-muted m-0">Fælles månedligt tema med ugentlige undertemaer og øvelser &bull; Alle bæltegrader træner sammen</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        @if (_currentPlan is not null)
        {
            <button type="button"
                    class="btn btn-brand-accent fw-bold d-flex align-items-center gap-2" 
                    disabled="@_isDownloadingPdf" 
                    @onclick="DownloadPdfAsync">
                @if (_isDownloadingPdf)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Genererer PDF...</span>
                }
                else
                {
                    <span aria-hidden="true">📄</span>
                    <span>Download PDF-læseplan</span>
                }
            </button>
            <button type="button"
                    class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center gap-1"
                    @onclick="ConfirmDeletePlan">
                <span aria-hidden="true">🗑️</span>
                <span>Nulstil plan</span>
            </button>
        }
    </div>
</div>

<!-- Date & Team Toolbar -->
<div class="card border-0 shadow-sm mb-4 bg-white" style="border-radius: 8px;">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <span class="form-label text-muted small fw-bold mb-1 d-block">Hold og gruppe</span>
                <div class="p-2 border rounded bg-light d-flex align-items-center gap-2">
                    <span class="badge" style="background-color: var(--brand-blue); color: var(--brand-yellow); font-weight: 800;"><span aria-hidden="true">🥋</span> 1 HOLD</span>
                    <span class="fw-bold text-dark small">Akademiets fælles læseplan (alle bælter og grader)</span>
                </div>
            </div>
            <div class="col-md-3">
                <label for="curriculum-month-select" class="form-label text-muted small fw-bold mb-1">Måned</label>
                <select id="curriculum-month-select" class="form-select" @bind="_selectedMonth" @bind:after="LoadPlanAsync">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="curriculum-year-select" class="form-label text-muted small fw-bold mb-1">År</label>
                <select id="curriculum-year-select" class="form-select" @bind="_selectedYear" @bind:after="LoadPlanAsync">
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                    <option value="2027">2027</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end pt-md-3">
                @if (_currentPlan is not null)
                {
                    <span class="badge @(_currentPlan.Status == PlanStatus.Published ? "bg-success" : "bg-warning text-dark") px-3 py-2 fw-bold">
                        @FormatPlanStatus(_currentPlan.Status)
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Main Planning Canvas -->
@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="progressbar" aria-label="Indlæser læseplan" style="color: var(--brand-blue) !important;">
            <span class="visually-hidden">Indlæser læseplan...</span>
        </div>
        <p class="text-muted mt-2">Indlæser månedlig læseplan...</p>
    </div>
}
else if (_currentPlan is null)
{
    <!-- Empty State: Initialize New Plan -->
    <div class="card border-0 shadow-sm text-center py-5 bg-white">
        <div class="card-body max-w-600 mx-auto" style="max-width: 600px;">
            <div style="font-size: 3.5rem;" aria-hidden="true">🥋</div>
            <h2 class="h3 fw-bold mt-2">Ingen læseplan for @GetMonthName(_selectedMonth) @_selectedYear</h2>
            <p class="text-muted mb-4">
                Opret månedens fælles læseplan for akademiet. Alle bæltegrader følger dette månedlige tema med ugentlige undertemaer og teknikprogressioner.
            </p>

            <form @onsubmit="CreatePlanAsync" @onsubmit:preventDefault>
                <div class="text-start mb-3">
                    <label for="curriculum-new-objective" class="form-label fw-bold text-dark small">Månedens hovedmål / tema</label>
                    <input id="curriculum-new-objective" type="text" class="form-control" @bind="_newObjective" placeholder="f.eks. Mount-kontrol og armbar-kombinationer" />
                </div>

                <fieldset class="text-start mb-4 border-0 p-0">
                    <legend class="form-label fw-bold text-dark small float-none w-auto px-0">Planens varighed</legend>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="weekCountRadio" id="week4" value="4" 
                                   checked="@(_newWeekCount == 4)" 
                                   @onchange="@(() => _newWeekCount = 4)" />
                            <label class="form-check-label fw-semibold" for="week4">
                                4 uger (standard)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="weekCountRadio" id="week5" value="5" 
                                   checked="@(_newWeekCount == 5)" 
                                   @onchange="@(() => _newWeekCount = 5)" />
                            <label class="form-check-label fw-semibold" for="week5">
                                5 uger (udvidet kalendermåned)
                            </label>
                        </div>
                    </div>
                </fieldset>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="alert alert-danger py-2 small text-start">@_createError</div>
                }

                <button type="submit" class="btn btn-brand-primary w-100 fw-bold py-2" disabled="@_isCreating">
                    @if (_isCreating)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        <span>Opretter plan...</span>
                    }
                    else
                    {
                        <span>+ Opret @_newWeekCount-ugers læseplan</span>
                    }
                </button>
            </form>
        </div>
    </div>
}
else
{
    <!-- Monthly Focus Objective Banner -->
    <div class="card border-0 shadow-sm mb-4 text-white" style="background-color: #0B0F19; border-left: 6px solid #FFEE00 !important; border-radius: 8px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="flex-grow-1">
                    <h2 class="text-uppercase small fw-bold m-0" style="color: #FFEE00; letter-spacing: 0.05em;">Månedens fokusmål</h2>
                    @if (_isEditingObjective)
                    {
                        <form class="d-flex gap-2 align-items-center mt-2 flex-wrap" @onsubmit="SaveObjectiveAsync" @onsubmit:preventDefault>
                            <label for="curriculum-edit-objective" class="visually-hidden">Månedens fokusmål</label>
                            <input id="curriculum-edit-objective"
                                   type="text"
                                   class="form-control form-control-sm text-dark bg-white fw-bold flex-grow-1" 
                                   @bind="_editingObjectiveText" 
                                   placeholder="Indtast månedens fokusmål..." />
                            <div class="d-flex gap-1">
                                <button type="submit" class="btn btn-sm btn-brand-accent fw-bold" disabled="@_isSavingObjective">
                                    @if (_isSavingObjective)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="progressbar" aria-label="Gemmer fokusmål"></span>
                                    }
                                    else
                                    {
                                        <span>Gem</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light" disabled="@_isSavingObjective" @onclick="CancelEditObjective">
                                    Annuller
                                </button>
                            </div>
                        </form>
                        @if (!string.IsNullOrEmpty(_objectiveError))
                        {
                            <div class="text-danger-on-dark small mt-1">@_objectiveError</div>
                        }
                    }
                    else
                    {
                        <h3 class="h5 m-0 mt-1 fw-bold">@_currentPlan.MonthlyObjective</h3>
                    }
                </div>
                @if (!_isEditingObjective)
                {
                    <button type="button" class="btn btn-sm btn-outline-light text-nowrap d-flex align-items-center gap-1" @onclick="StartEditObjective">
                        <span aria-hidden="true">✏️</span>
                        <span>Rediger mål</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Kanban Board (4 or 5 Weeks) -->
    <h2 class="visually-hidden">Ugeoversigt</h2>
    <div class="row g-3">
        @foreach (var week in _currentPlan.Weeks.OrderBy(w => w.WeekNumber))
        {
            var colClass = _currentPlan.Weeks.Count == 5 ? "col-lg col-md-6" : "col-lg-3 col-md-6";
            <div class="@colClass" @key="week.WeekNumber">
                <div class="card border-0 shadow-sm h-100 d-flex flex-column bg-white kanban-column" style="border-radius: 8px; border-top: 4px solid #20409A !important;">
                    <!-- Column Header -->
                    <div class="card-header bg-white border-bottom py-3">
                        <h3 class="visually-hidden">Uge @week.WeekNumber</h3>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-dark border fw-bold">Uge @week.WeekNumber</span>
                            <span class="small text-muted">@week.Techniques.Count @(week.Techniques.Count == 1 ? "øvelse" : "øvelser")</span>
                        </div>

                        <!-- Weekly Sub-Theme with Inline Editing -->
                        @if (_editingWeekNumber == week.WeekNumber)
                        {
                            <form class="mt-2" @onsubmit="() => SaveWeekThemeAsync(week.WeekNumber)" @onsubmit:preventDefault>
                                <label for="week-theme-input-@week.WeekNumber" class="visually-hidden">Undertema for uge @week.WeekNumber</label>
                                <input id="week-theme-input-@week.WeekNumber"
                                       type="text"
                                       class="form-control form-control-sm mb-1 fw-semibold" 
                                       @bind="_editingWeekThemeText" 
                                       placeholder="f.eks. Closed Guard-sweeps" />
                                <div class="d-flex gap-1 justify-content-end">
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" disabled="@_isSavingWeekTheme" @onclick="CancelEditWeekTheme">
                                        Annuller
                                    </button>
                                    <button type="submit" class="btn btn-xs btn-brand-primary py-0 px-2 fw-bold" disabled="@_isSavingWeekTheme">
                                        @if (_isSavingWeekTheme)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="progressbar" aria-label="Gemmer ugetema"></span>
                                        }
                                        else
                                        {
                                            <span>Gem</span>
                                        }
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(_weekThemeError))
                                {
                                    <div class="text-danger small mt-1" style="font-size: 0.75rem;">@_weekThemeError</div>
                                }
                            </form>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-start gap-1 mt-1">
                                <div class="fw-bold text-dark flex-grow-1" style="font-size: 0.95rem;">
                                    @if (string.IsNullOrWhiteSpace(week.Theme))
                                    {
                                        <span class="text-muted fst-italic fw-normal" style="font-size: 0.85rem;">(Intet ugetema angivet)</span>
                                    }
                                    else
                                    {
                                        @week.Theme
                                    }
                                </div>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-xs p-1 text-decoration-none"
                                        title="Rediger ugetema"
                                        aria-label="Rediger ugetema for uge @week.WeekNumber"
                                        @onclick="() => StartEditWeekTheme(week.WeekNumber, week.Theme)">
                                    <span aria-hidden="true">✏️</span>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Column Body: Techniques List -->
                    <div class="card-body p-2 flex-grow-1 d-flex flex-column gap-2" style="background-color: #F8FAFC; min-height: 280px;">
                        @if (!week.Techniques.Any())
                        {
                            <div class="text-center text-muted small py-4 my-auto">
                                <em>Ingen teknikker tilføjet endnu</em>
                            </div>
                        }
                        else
                        {
                            @foreach (var tech in week.Techniques.OrderBy(t => t.SortOrder))
                            {
                                <div class="card border shadow-xs p-2 bg-white technique-card position-relative" @key="tech.Id">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge category-badge-@tech.Category.ToString().ToLower() small">
                                            @tech.Category
                                        </span>
                                        <div class="d-flex align-items-center gap-1">
                                            @{
                                                var safeReferenceUrl = SafeUrlValidator.SanitizeExternalUrl(tech.ReferenceUrl);
                                            }
                                            @if (safeReferenceUrl is not null)
                                            {
                                                <a href="@safeReferenceUrl"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="small text-decoration-none video-link me-1"
                                                   title="Se video for @tech.Title"
                                                   aria-label="Se video for @tech.Title">
                                                    <span aria-hidden="true">▶</span> Video
                                                </a>
                                            }
                                            <button type="button"
                                                    class="btn btn-sm btn-link p-0 text-muted"
                                                    title="Rediger teknik"
                                                    aria-label="Rediger @tech.Title"
                                                    @onclick="() => OpenEditTechnique(week.WeekNumber, tech)">
                                                <span aria-hidden="true">✏️</span>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-link p-0 text-danger ms-1"
                                                    title="Slet teknik"
                                                    aria-label="Slet @tech.Title"
                                                    @onclick="() => ConfirmDeleteTechnique(week.WeekNumber, tech.Id, tech.Title)">
                                                <span aria-hidden="true">🗑️</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="fw-bold text-dark small">@tech.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(tech.CoachingNotes))
                                    {
                                        <div class="text-muted small mt-1 font-monospace" style="font-size: 0.78rem;">
                                            @tech.CoachingNotes
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Column Footer: Add Drill Button -->
                    <div class="card-footer bg-white border-top p-2">
                        <button type="button"
                                class="btn btn-outline-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-1"
                                style="color: var(--brand-blue); border-color: var(--brand-blue);"
                                aria-label="Tilføj teknik til uge @week.WeekNumber"
                                @onclick="() => OpenAddTechnique(week.WeekNumber)">
                            <span aria-hidden="true">+</span> Tilføj øvelse / teknik
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Modals -->
    @if (_selectedWeekForAdd > 0)
    {
        <AddTechniqueModal 
            @bind-IsOpen="_showAddModal" 
            PlanId="_currentPlan.Id" 
            WeekNumber="_selectedWeekForAdd" 
            OnTechniqueAdded="HandleTechniqueAdded" />
    }

    @if (_showEditModal && _techniqueToEdit is not null)
    {
        <EditTechniqueModal 
            @bind-IsOpen="_showEditModal" 
            PlanId="_currentPlan.Id" 
            WeekNumber="_selectedWeekForEdit" 
            Technique="_techniqueToEdit" 
            OnTechniqueUpdated="HandleTechniqueUpdated" />
    }

    <ModalDialog IsOpen="_showDeleteTechModal"
                 OnClose="CancelDeleteTechnique"
                 Title="Slet øvelse / teknik"
                 HeaderClass="bg-danger text-white border-0"
                 LightDismiss="false">
        <ChildContent>
            <p class="mb-0">Er du sikker på, at du vil fjerne <strong>@_deleteTechTitle</strong> fra uge @_deleteTechWeekNumber?</p>
            @if (!string.IsNullOrEmpty(_deleteTechError))
            {
                <div class="alert alert-danger mt-3 py-2 small">@_deleteTechError</div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" autofocus @onclick="CancelDeleteTechnique">Annuller</button>
            <button type="button" class="btn btn-danger fw-bold" disabled="@_isDeletingTech" @onclick="ExecuteDeleteTechniqueAsync">
                @if (_isDeletingTech)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    <span>Sletter...</span>
                }
                else
                {
                    <span>Slet</span>
                }
            </button>
        </FooterContent>
    </ModalDialog>

    <ModalDialog IsOpen="_showDeletePlanModal"
                 OnClose="CancelDeletePlan"
                 Title="Nulstil månedlig læseplan"
                 HeaderClass="bg-danger text-white border-0"
                 LightDismiss="false">
        <ChildContent>
            <p>Er du sikker på, at du vil nulstille og slette læseplanen for <strong>@GetMonthName(_selectedMonth) @_selectedYear</strong>?</p>
            <p class="text-muted small mb-0">Dette fjerner alle ugentlige temaer og planlagte teknikker for denne måned, så du kan starte helt forfra.</p>
            @if (!string.IsNullOrEmpty(_deletePlanError))
            {
                <div class="alert alert-danger mt-3 py-2 small">@_deletePlanError</div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" autofocus @onclick="CancelDeletePlan">Annuller</button>
            <button type="button" class="btn btn-danger fw-bold" disabled="@_isDeletingPlan" @onclick="ExecuteDeletePlanAsync">
                @if (_isDeletingPlan)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    <span>Nulstiller...</span>
                }
                else
                {
                    <span>Ja, nulstil plan</span>
                }
            </button>
        </FooterContent>
    </ModalDialog>
}

@code {
    private static readonly CultureInfo DaDkCulture = CultureInfo.GetCultureInfo("da-DK");

    [SupplyParameterFromQuery] public int? Year { get; set; }
    [SupplyParameterFromQuery] public int? Month { get; set; }

    private readonly Guid _academyId = Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");
    private readonly Guid _unifiedProgramId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int _selectedMonth = DateTime.UtcNow.Month;
    private int _selectedYear = DateTime.UtcNow.Year;

    private MonthlyPlanDto? _currentPlan;
    private bool _isLoading = true;
    private bool _isCreating;
    private bool _isDownloadingPdf;
    private string _newObjective = "Mount-kontrol og armbar-kombinationer";
    private int _newWeekCount = 4;
    private string? _createError;

    private bool _isEditingObjective;
    private string _editingObjectiveText = "";
    private bool _isSavingObjective;
    private string? _objectiveError;

    private int? _editingWeekNumber;
    private string _editingWeekThemeText = "";
    private bool _isSavingWeekTheme;
    private string? _weekThemeError;

    private bool _showAddModal;
    private int _selectedWeekForAdd;

    private bool _showEditModal;
    private int _selectedWeekForEdit;
    private TechniqueDrillDto? _techniqueToEdit;

    private bool _showDeleteTechModal;
    private int _deleteTechWeekNumber;
    private Guid _deleteTechId;
    private string _deleteTechTitle = "";
    private bool _isDeletingTech;
    private string? _deleteTechError;

    private bool _showDeletePlanModal;
    private bool _isDeletingPlan;
    private string? _deletePlanError;
    private IJSObjectReference? _interopModule;

    protected override async Task OnInitializedAsync()
    {
        if (Year.HasValue && Month.HasValue)
        {
            _selectedYear = Year.Value;
            _selectedMonth = Month.Value;
        }
        await LoadPlanAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Year.HasValue && Month.HasValue && (Year.Value != _selectedYear || Month.Value != _selectedMonth))
        {
            _selectedYear = Year.Value;
            _selectedMonth = Month.Value;
            await LoadPlanAsync();
        }
    }

    private static string GetMonthName(int month)
    {
        var name = DaDkCulture.DateTimeFormat.GetMonthName(month);
        return string.IsNullOrEmpty(name) ? name : char.ToUpper(name[0], DaDkCulture) + name[1..];
    }

    private static string FormatPlanStatus(PlanStatus status) =>
        status == PlanStatus.Published ? "UDGIVET" : "KLADDE";

    private async Task LoadPlanAsync()
    {
        _isLoading = true;
        _isEditingObjective = false;
        _editingWeekNumber = null;
        try
        {
            _currentPlan = await CurriculumApi.GetPlanAsync(_academyId, _unifiedProgramId, _selectedYear, _selectedMonth);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreatePlanAsync()
    {
        if (string.IsNullOrWhiteSpace(_newObjective))
        {
            _createError = "Angiv venligst månedens hovedmål.";
            return;
        }

        _createError = null;
        _isCreating = true;
        try
        {
            var req = new CreateMonthlyPlanRequest(
                AcademyId: _academyId,
                ProgramId: _unifiedProgramId,
                Year: _selectedYear,
                Month: _selectedMonth,
                Objective: _newObjective.Trim(),
                CreatedByInstructorId: Guid.NewGuid(),
                WeekCount: _newWeekCount
            );

            var result = await CurriculumApi.CreatePlanAsync(req);
            if (result.IsFailure)
            {
                _createError = result.Error;
                return;
            }

            _currentPlan = result.Value;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void StartEditObjective()
    {
        if (_currentPlan is null) return;
        _editingObjectiveText = _currentPlan.MonthlyObjective;
        _objectiveError = null;
        _isEditingObjective = true;
    }

    private void CancelEditObjective()
    {
        _isEditingObjective = false;
        _objectiveError = null;
    }

    private async Task SaveObjectiveAsync()
    {
        if (_currentPlan is null) return;
        if (string.IsNullOrWhiteSpace(_editingObjectiveText))
        {
            _objectiveError = "Månedens fokusmål må ikke være tomt.";
            return;
        }

        _isSavingObjective = true;
        _objectiveError = null;
        try
        {
            var result = await CurriculumApi.UpdateObjectiveAsync(_currentPlan.Id, _editingObjectiveText.Trim());
            if (result.IsFailure)
            {
                _objectiveError = result.Error;
                return;
            }

            _currentPlan = result.Value;
            _isEditingObjective = false;
        }
        finally
        {
            _isSavingObjective = false;
        }
    }

    private void StartEditWeekTheme(int weekNumber, string currentTheme)
    {
        _editingWeekNumber = weekNumber;
        _editingWeekThemeText = currentTheme;
        _weekThemeError = null;
    }

    private void CancelEditWeekTheme()
    {
        _editingWeekNumber = null;
        _weekThemeError = null;
    }

    private async Task SaveWeekThemeAsync(int weekNumber)
    {
        if (_currentPlan is null) return;
        if (string.IsNullOrWhiteSpace(_editingWeekThemeText))
        {
            _weekThemeError = "Ugetemaet må ikke være tomt.";
            return;
        }

        _isSavingWeekTheme = true;
        _weekThemeError = null;
        try
        {
            var result = await CurriculumApi.UpdateWeekThemeAsync(_currentPlan.Id, weekNumber, _editingWeekThemeText.Trim());
            if (result.IsFailure)
            {
                _weekThemeError = result.Error;
                return;
            }

            _currentPlan = result.Value;
            _editingWeekNumber = null;
        }
        finally
        {
            _isSavingWeekTheme = false;
        }
    }

    private void OpenAddTechnique(int weekNumber)
    {
        _selectedWeekForAdd = weekNumber;
        _showAddModal = true;
    }

    private void HandleTechniqueAdded(MonthlyPlanDto updatedPlan)
    {
        _currentPlan = updatedPlan;
    }

    private void OpenEditTechnique(int weekNumber, TechniqueDrillDto tech)
    {
        _selectedWeekForEdit = weekNumber;
        _techniqueToEdit = tech;
        _showEditModal = true;
    }

    private void HandleTechniqueUpdated(MonthlyPlanDto updatedPlan)
    {
        _currentPlan = updatedPlan;
    }

    private void ConfirmDeleteTechnique(int weekNumber, Guid techniqueId, string title)
    {
        _deleteTechWeekNumber = weekNumber;
        _deleteTechId = techniqueId;
        _deleteTechTitle = title;
        _deleteTechError = null;
        _showDeleteTechModal = true;
    }

    private void CancelDeleteTechnique()
    {
        _showDeleteTechModal = false;
        _deleteTechError = null;
    }

    private async Task ExecuteDeleteTechniqueAsync()
    {
        if (_currentPlan is null) return;
        _isDeletingTech = true;
        _deleteTechError = null;

        try
        {
            var result = await CurriculumApi.DeleteTechniqueAsync(_currentPlan.Id, _deleteTechWeekNumber, _deleteTechId);
            if (result.IsFailure)
            {
                _deleteTechError = result.Error;
                return;
            }

            _currentPlan = result.Value;
            _showDeleteTechModal = false;
        }
        finally
        {
            _isDeletingTech = false;
        }
    }

    private void ConfirmDeletePlan()
    {
        _deletePlanError = null;
        _showDeletePlanModal = true;
    }

    private void CancelDeletePlan()
    {
        _showDeletePlanModal = false;
        _deletePlanError = null;
    }

    private async Task ExecuteDeletePlanAsync()
    {
        if (_currentPlan is null) return;
        _isDeletingPlan = true;
        _deletePlanError = null;

        try
        {
            var result = await CurriculumApi.DeletePlanAsync(_currentPlan.Id);
            if (result.IsFailure)
            {
                _deletePlanError = result.Error;
                return;
            }

            _showDeletePlanModal = false;
            _currentPlan = null;
        }
        finally
        {
            _isDeletingPlan = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (_currentPlan is null) return;
        _isDownloadingPdf = true;

        try
        {
            var pdfBytes = await CurriculumApi.DownloadPlanPdfAsync(_currentPlan.Id);
            if (pdfBytes is not null && pdfBytes.Length > 0)
            {
                var fileName = $"Syllabus_{_currentPlan.Year}_{_currentPlan.Month:D2}.pdf";
                using var stream = new MemoryStream(pdfBytes);
                using var streamRef = new DotNetStreamReference(stream);
                _interopModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-interop.js");
                await _interopModule.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef, "application/pdf");
            }
        }
        finally
        {
            _isDownloadingPdf = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_interopModule is not null)
        {
            try
            {
                await _interopModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            _interopModule = null;
        }
    }
}
