@page "/members/{Id:guid}"
@inject IMemberApiClient MemberApi
@inject NavigationManager Nav

<PageTitle>@(_member is not null ? $"{_member.FirstName} {_member.LastName} | BjjSM" : "Medlemsprofil | BjjSM")</PageTitle>

<div class="mb-3">
    <a href="members" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <span aria-hidden="true">←</span> Tilbage til medlemsoversigt
    </a>
</div>

@if (_isLoading)
{
    <h1 class="visually-hidden">Medlemsprofil</h1>
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="progressbar" aria-label="Indlæser medlemsprofil" style="color: var(--brand-blue) !important;">
            <span class="visually-hidden">Indlæser medlemsoplysninger...</span>
        </div>
        <p class="text-muted mt-2">Indlæser medlemsprofil...</p>
    </div>
}
else if (_member is null)
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white">
        <div class="card-body">
            <h1 class="h4 fw-bold">Medlem ikke fundet</h1>
            <p class="text-muted">Den ønskede medlemsprofil findes ikke eller er blevet fjernet.</p>
            <a href="members" class="btn btn-brand-primary">Tilbage til medlemsoversigt</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Practitioner Info Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 8px;">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="avatar-circle-lg" aria-hidden="true">
                        @_member.FirstName[0]@_member.LastName[0]
                    </div>
                    <div>
                        <h1 class="h3 m-0 fw-bold text-dark">@_member.FirstName @_member.LastName</h1>
                        <span class="badge @(_member.Roles.HasFlag(PractitionerRole.Instructor) ? "bg-dark" : "bg-light text-dark border") mt-1">
                            @FormatRoles(_member.Roles)
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Aktiv grad og striber</span>
                    <BjjBeltBadge Rank="@_member.CurrentRank" />
                </div>

                <div class="d-grid mb-4">
                    <button type="button" class="btn btn-brand-accent fw-bold" @onclick="() => _showPromoteModal = true">
                        <span aria-hidden="true">🎓</span> Tildel bælte- eller stribegraduering
                    </button>
                </div>

                <dl class="border-top pt-3 mb-0">
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <dt class="fw-normal">E-mail:</dt>
                        <dd class="text-dark fw-medium mb-0">@_member.Email</dd>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <dt class="fw-normal">Akademi-ID:</dt>
                        <dd class="text-dark font-monospace small mb-0">@_member.AcademyId.ToString()[..8]...</dd>
                    </div>
                    <div class="d-flex justify-content-between text-muted small">
                        <dt class="fw-normal">Bælterække:</dt>
                        <dd class="text-dark fw-medium mb-0">@_member.CurrentRank.Ladder</dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Graduation History Timeline -->
        <div class="col-lg-7">
            <h2 class="visually-hidden">Gradueringsoversigt</h2>
            <GraduationTimeline Graduations="@_member.Graduations" />
        </div>
    </div>

    <PromoteMemberModal 
        @bind-IsOpen="_showPromoteModal" 
        Member="_member" 
        OnMemberPromoted="HandleMemberPromoted" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private MemberDto? _member;
    private bool _isLoading = true;
    private bool _showPromoteModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadMemberAsync();
    }

    private async Task LoadMemberAsync()
    {
        _isLoading = true;
        try
        {
            _member = await MemberApi.GetMemberByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleMemberPromoted(MemberDto updatedMember)
    {
        _member = updatedMember;
    }

    private static string FormatRoles(PractitionerRole roles)
    {
        var labels = new List<string>();
        if (roles.HasFlag(PractitionerRole.Instructor))
        {
            labels.Add("Instruktør");
        }

        if (roles.HasFlag(PractitionerRole.Student))
        {
            labels.Add("Elev");
        }

        return labels.Count > 0 ? string.Join(", ", labels) : roles.ToString();
    }
}
