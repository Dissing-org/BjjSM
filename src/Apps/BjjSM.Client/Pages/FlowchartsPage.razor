@page "/flowcharts"

<PageTitle>BjjSM - Grappling Flowcharts</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold text-dark m-0">🗺️ Grappling Flowcharts</h1>
        <p class="text-muted m-0">Interactive game plan matrices, tactical positions & technique transitions</p>
    </div>
    <div>
        <button class="btn btn-brand-primary d-flex align-items-center gap-2" @onclick="OpenCreateModal">
            <span>+</span> New Flowchart
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-left: 5px solid #DC2626 !important; background-color: #FEF2F2;">
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-danger fw-bold">⚠️ @_errorMessage</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="LoadFlowchartsAsync">Retry</button>
        </div>
    </div>
}
else if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="color: var(--brand-blue, #20409A) !important;">
            <span class="visually-hidden">Loading flowcharts...</span>
        </div>
        <p class="text-muted mt-2">Loading game plans...</p>
    </div>
}
else if (!_flowcharts.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white" style="border-radius: 8px;">
        <div class="card-body">
            <div style="font-size: 3rem;">🗺️</div>
            <h4 class="fw-bold mt-2">No Flowcharts Yet</h4>
            <p class="text-muted">Build a custom game plan or choose from BJJ starter templates like Closed Guard Matrix or Half Guard Underhook.</p>
            <button class="btn btn-brand-primary" @onclick="OpenCreateModal">
                Create First Flowchart
            </button>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var fc in _flowcharts)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm flowchart-card" style="border-radius: 8px; border-top: 4px solid #20409A !important;">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark m-0">@fc.Title</h5>
                            <span class="badge" style="background-color: #EBF0FA; color: #20409A; font-weight: 700;">
                                @fc.NodeCount @(fc.NodeCount == 1 ? "Node" : "Nodes")
                            </span>
                        </div>
                        <p class="text-muted small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(fc.Description) ? "Custom game plan" : fc.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto small text-muted">
                            <span>Updated @fc.UpdatedAt.ToString("MMM dd, yyyy")</span>
                            <div class="d-flex gap-2">
                                <a href="flowcharts/@fc.Id" class="btn btn-sm btn-brand-primary px-3">
                                    Open Canvas
                                </a>
                                <button class="btn btn-sm btn-outline-danger" title="Delete Flowchart" @onclick="() => DeleteFlowchartAsync(fc.Id)">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Create Flowchart Modal -->
@if (_showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(5, 5, 5, 0.65);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 8px;">
                <div class="modal-header text-white" style="background-color: #20409A;">
                    <h5 class="modal-title fw-bold">🥋 New Grappling Flowchart</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">START FROM TEMPLATE</label>
                        <select class="form-select" @bind="_selectedPresetKey">
                            <option value="">Blank Flowchart (Custom)</option>
                            @foreach (var preset in _presets)
                            {
                                <option value="@preset.Key">@preset.Title</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(_selectedPresetKey))
                        {
                            var selected = _presets.FirstOrDefault(p => p.Key == _selectedPresetKey);
                            if (selected is not null)
                            {
                                <div class="form-text mt-1 text-primary">@selected.Description</div>
                            }
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">FLOWCHART TITLE</label>
                        <input type="text" class="form-control" placeholder="e.g., Closed Guard Submission Matrix" @bind="_newTitle" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">DESCRIPTION (OPTIONAL)</label>
                        <textarea class="form-control" rows="2" placeholder="Brief notes about the strategic focus..." @bind="_newDescription"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_createModalError))
                    {
                        <div class="text-danger small mt-2">@_createModalError</div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateModal">Cancel</button>
                    <button type="button" class="btn btn-brand-primary" @onclick="CreateFlowchartAsync" disabled="@_isCreating">
                        @if (_isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Flowchart</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
