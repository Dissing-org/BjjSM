@page "/talents"

<PageTitle>Talenter | BjjSM</PageTitle>

<WowAchievementToast Current="@_activeToast" OnDismiss="() => _activeToast = null" />

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold text-dark m-0"><span aria-hidden="true">⚡</span> BJJ-talenttræ</h1>
        <p class="text-muted m-0">Klassisk talentprogression &bull; Dynamisk talentbygger</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="btn btn-brand-accent fw-bold d-flex align-items-center gap-1 shadow-sm" @onclick="OpenAchievementsModal">
            <span aria-hidden="true">🏆</span> Trofæer (@_unlockedAchievementCount/@_achievements.Count)
        </button>
        <div class="badge px-3 py-2 fs-6 fw-bold shadow-sm" style="background-color: var(--brand-blue); color: var(--brand-yellow); border: 1px solid var(--brand-yellow);">
            <span>Investeret: @_totalPointsInvested point</span>
        </div>
        <button type="button" class="btn btn-warning fw-bold d-flex align-items-center gap-1 shadow-sm text-dark" @onclick="() => OpenCreateModal(1, 1)">
            <span aria-hidden="true">➕</span> Opret nyt talent
        </button>
        <button type="button" class="btn btn-outline-danger fw-bold d-flex align-items-center gap-1 shadow-sm" @onclick="ResetPointsAsync">
            <span aria-hidden="true">↺</span> Nulstil point
        </button>
        <button type="button" class="btn btn-outline-secondary fw-bold d-flex align-items-center gap-1 shadow-sm" @onclick="RequestResetToDefaults" title="Gendan de 12 grundlæggende BJJ-standardtalenter">
            <span aria-hidden="true">⚙️</span> Nulstil til standardtræ
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm p-3 mb-4 bg-white" style="border-radius: 8px; border-left: 4px solid var(--brand-blue) !important;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4" aria-hidden="true">🥋</span>
            <div>
                <span class="fw-bold text-dark">Talentmekanik og bygger:</span>
                <span class="text-muted small ms-1">
                    <strong>Venstreklik</strong> for at tilføje rang. <strong>Højreklik</strong> for at fjerne rang. Brug redigeringsknappen (<strong>✎</strong>) for at redigere et talent, eller klik på en <strong>ledig plads (+)</strong> for at designe dit eget talent.
                </span>
            </div>
        </div>
    </div>
</div>

<ErrorBoundary>
    <ChildContent>
        <div class="wow-tree-canvas shadow-lg">
            <div class="wow-tree-header text-center mb-4">
                <h2 class="wow-tree-title m-0">GRUNDLÆGGENDE</h2>
                <span class="wow-tree-subtitle">Grundlæggende BJJ-positions- og kampprogression</span>
            </div>

            @{
                RenderFragment RenderSlot(int row, int col) => __builder =>
                {
                    var talent = _talents.FirstOrDefault(t => t.Row == row && t.Col == col);
                    if (talent is not null)
                    {
                        var tooltipClass = col == 1 ? "tooltip-right" : (col == 3 ? "tooltip-left" : (row >= 5 ? "tooltip-right" : "tooltip-left"));
                        var safeVideoUrl = SafeUrlValidator.SanitizeExternalUrl(talent.VideoUrl);
                        <div class="wow-talent-container">
                            <div class="wow-talent-slot-wrapper">
                                <button type="button"
                                        class="wow-talent-slot @GetSlotCss(talent)"
                                        aria-label="@($"{talent.Name}, rang {talent.CurrentRank} af {talent.MaxRank}")"
                                        @onclick="() => IncrementTalent(talent)"
                                        @oncontextmenu="() => DecrementTalent(talent)"
                                        @oncontextmenu:preventDefault="true">
                                    <span class="wow-talent-icon" aria-hidden="true">@talent.Icon</span>
                                    <span class="wow-rank-badge @GetRankBadgeCss(talent)" aria-hidden="true">
                                        @talent.CurrentRank/@talent.MaxRank
                                    </span>
                                </button>
                                @if (safeVideoUrl is not null)
                                {
                                    <a href="@safeVideoUrl" target="_blank" rel="noopener noreferrer"
                                       class="wow-talent-video-btn"
                                       title="Se videovejledning (åbner i ny fane)"
                                       aria-label="@($"Se video for {talent.Name}")">
                                        <span aria-hidden="true">▶</span>
                                    </a>
                                }
                                <button type="button"
                                        class="wow-talent-edit-btn"
                                        title="Rediger talent"
                                        aria-label="@($"Rediger {talent.Name}")"
                                        @onclick="() => OpenEditModal(talent)">
                                    <span aria-hidden="true">✎</span>
                                </button>

                                <!-- WoW Tooltip -->
                                <div class="wow-tooltip @tooltipClass">
                                    <div class="tooltip-header">
                                        <span class="tooltip-title">@talent.Name</span>
                                        <span class="tooltip-rank">Rang @talent.CurrentRank/@talent.MaxRank</span>
                                    </div>
                                    @if (talent.CurrentRank > 0)
                                    {
                                        <div class="tooltip-desc text-white mb-2">@talent.GetCurrentDescription()</div>
                                    }
                                    @if (!talent.IsMaxed)
                                    {
                                        <div class="tooltip-next-label">Næste rang:</div>
                                        <div class="tooltip-next-desc mb-2">@talent.GetNextDescription()</div>
                                    }
                                    @if (!CanIncrement(talent) && !talent.IsMaxed)
                                    {
                                        <div class="tooltip-locked"><span aria-hidden="true">⚠️</span> Kræver @talent.RequiredPointsInTree point i BJJ-talenter</div>
                                    }
                                    @if (safeVideoUrl is not null)
                                    {
                                        <div class="tooltip-video-section my-2">
                                            <a href="@safeVideoUrl" target="_blank" rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-warning w-100 fw-bold d-flex align-items-center justify-content-center gap-1 tooltip-video-link">
                                                <span aria-hidden="true">📺</span> Se videovejledning <span class="small" aria-hidden="true">↗</span>
                                            </a>
                                        </div>
                                    }
                                    <div class="tooltip-footer">
                                        <span>Venstreklik for at lære</span>
                                        <span>Højreklik for at fjerne</span>
                                    </div>
                                </div>
                            </div>
                            <div class="wow-talent-label">@talent.Name</div>
                            <div class="wow-slot-actions">
                                <button type="button" class="wow-btn-mini btn-decrement"
                                        title="Fjern point"
                                        aria-label="@($"Fjern point fra {talent.Name}")"
                                        disabled="@(!CanDecrement(talent))"
                                        @onclick="() => DecrementTalent(talent)">−</button>
                                <button type="button" class="wow-btn-mini btn-increment"
                                        title="Tilføj point"
                                        aria-label="@($"Tilføj point til {talent.Name}")"
                                        disabled="@(!CanIncrement(talent))"
                                        @onclick="() => IncrementTalent(talent)">+</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="wow-talent-container">
                            <button type="button" class="wow-talent-slot empty-slot" @onclick="() => OpenCreateModal(row, col)" title="@($"Tilføj talent til række {row} (kolonne {col})")" aria-label="@($"Tilføj talent til række {row}, kolonne {col}")">
                                <span class="fs-4" aria-hidden="true">➕</span>
                                <span class="empty-slot-label">Tilføj talent</span>
                            </button>
                            <div class="wow-talent-label text-muted">Ledig plads</div>
                        </div>
                    }
                };
            }

            <!-- Row 1: 2 Talents (Col 1, Col 2) -->
            <div class="wow-row wow-row-2col">
                @RenderSlot(1, 1)
                @RenderSlot(1, 2)
            </div>

            <!-- Connector Row 1 -> Row 2 -->
            <div class="wow-row-connector">
                <div class="wow-connector-line"></div>
            </div>

            <!-- Row 2: 3 Talents (Col 1, Col 2, Col 3) -->
            <div class="wow-row wow-row-3col">
                @RenderSlot(2, 1)
                @RenderSlot(2, 2)
                @RenderSlot(2, 3)
            </div>

            <!-- Connector Row 2 -> Row 3 -->
            <div class="wow-row-connector">
                <div class="wow-connector-line"></div>
            </div>

            <!-- Row 3: 3 Talents (Col 1, Col 2, Col 3) -->
            <div class="wow-row wow-row-3col">
                @RenderSlot(3, 1)
                @RenderSlot(3, 2)
                @RenderSlot(3, 3)
            </div>

            <!-- Connector Row 3 -> Row 4 -->
            <div class="wow-row-connector">
                <div class="wow-connector-line"></div>
            </div>

            <!-- Row 4: 3 Talents (Col 1, Col 2, Col 3) -->
            <div class="wow-row wow-row-3col">
                @RenderSlot(4, 1)
                @RenderSlot(4, 2)
                @RenderSlot(4, 3)
            </div>

            <!-- Connector Row 4 -> Row 5 -->
            <div class="wow-row-connector">
                <div class="wow-connector-line"></div>
            </div>

            <!-- Row 5: 1 Talent centered (Col 2) -->
            <div class="wow-row wow-row-1col">
                @RenderSlot(5, 2)
            </div>

            <!-- Connector Row 5 -> Row 6 -->
            <div class="wow-row-connector">
                <div class="wow-connector-line"></div>
            </div>

            <!-- Row 6: 1 Talent centered - Capstone (Col 2) -->
            <div class="wow-row wow-row-1col">
                @RenderSlot(6, 2)
            </div>
        </div>
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="alert alert-danger my-4 p-4 text-center" role="alert">
            <h2 class="h5 fw-bold">Der opstod en fejl under visning af talenttræet</h2>
            <p class="mb-3">@ex.Message</p>
            <button type="button" class="btn btn-warning fw-bold text-dark" @onclick="RequestResetToDefaults">
                <span aria-hidden="true">⚙️</span> Gendan standardtalenttræ
            </button>
        </div>
    </ErrorContent>
</ErrorBoundary>

<!-- Create / Edit Modal -->
<ModalDialog IsOpen="_showModal"
             OnClose="CloseModal"
             Title="@(_formModel.IsNew ? "Opret nyt talent" : "Rediger talent")"
             DialogClass="bjj-dialog-lg bjj-dialog-dark"
             FooterClass="justify-content-between"
             LightDismiss="false">
    <ChildContent>
        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger py-2 mb-3" role="alert">@_formError</div>
        }

        <form id="edit-talent-form" @onsubmit="SaveTalentAsync" @onsubmit:preventDefault="true">
            <div class="row g-3">
                <!-- Row Selection -->
                <div class="col-md-6">
                    <label for="talent-row" class="form-label fw-bold text-warning small">Rækkeplacering</label>
                    <select id="talent-row"
                            class="form-select bg-dark text-white border-secondary"
                            value="@_formModel.Row"
                            @onchange="OnRowSelected">
                        <option value="1">Række 1 (Guards &bull; Kræver 0 point)</option>
                        <option value="2">Række 2 (Guard-passeringer &bull; Kræver 5 point)</option>
                        <option value="3">Række 3 (Kontrolpositioner &bull; Kræver 10 point)</option>
                        <option value="4">Række 4 (Mount-mestring &bull; Kræver 15 point)</option>
                        <option value="5">Række 5 (Rygkontrol &bull; Kræver 20 point)</option>
                        <option value="6">Række 6 (Grundlæggende mester &bull; Kræver 25 point)</option>
                    </select>
                </div>

                <!-- Column Selection -->
                <div class="col-md-6">
                    <label for="talent-col" class="form-label fw-bold text-warning small">Kolonneplacering</label>
                    @if (_formModel.Row == 1)
                    {
                        <select id="talent-col" class="form-select bg-dark text-white border-secondary" @bind="_formModel.Col">
                            <option value="1">Venstre side (Kolonne 1)</option>
                            <option value="2">Højre side (Kolonne 2)</option>
                        </select>
                    }
                    else if (_formModel.Row >= 2 && _formModel.Row <= 4)
                    {
                        <select id="talent-col" class="form-select bg-dark text-white border-secondary" @bind="_formModel.Col">
                            <option value="1">Venstre side (Kolonne 1)</option>
                            <option value="2">Midte (Kolonne 2)</option>
                            <option value="3">Højre side (Kolonne 3)</option>
                        </select>
                    }
                    else
                    {
                        <input id="talent-col" type="text" class="form-control bg-dark text-muted border-secondary" value="Centreret (Kolonne 2)" disabled />
                    }
                </div>

                <!-- Talent Name -->
                <div class="col-12">
                    <label for="talent-name" class="form-label fw-bold text-warning small">Talentnavn</label>
                    <input id="talent-name"
                           type="text"
                           class="form-control bg-dark text-white border-secondary"
                           required
                           @bind="_formModel.Name"
                           placeholder="F.eks. Full guard, Mount, Back..." />
                </div>

                <!-- Icon Chooser -->
                <div class="col-12">
                    <span class="form-label d-block fw-bold text-warning small">Vælg ikon (emoji)</span>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                        @foreach (var emoji in new[] { "🥋", "⚡", "🤼", "🦅", "🗡️", "🛡️", "⛓️", "🔄", "👑", "🔥", "🪢", "🐍", "🌟" })
                        {
                            <button @key="emoji"
                                    type="button"
                                    class="btn btn-sm @(_formModel.Icon == emoji ? "btn-warning" : "btn-outline-secondary") fs-5 p-1 px-2"
                                    aria-label="@($"Vælg ikon {emoji}")"
                                    aria-pressed="@(_formModel.Icon == emoji ? "true" : "false")"
                                    @onclick="() => SetFormIcon(emoji)">
                                <span aria-hidden="true">@emoji</span>
                            </button>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label for="talent-custom-icon" class="small text-muted">Eller brugerdefineret:</label>
                        <input id="talent-custom-icon"
                               type="text"
                               class="form-control bg-dark text-white border-secondary"
                               style="max-width: 90px; text-align: center; font-size: 1.2rem;"
                               @bind="_formModel.Icon"
                               maxlength="4" />
                    </div>
                </div>

                <!-- Description Format -->
                <div class="col-12">
                    <label for="talent-description" class="form-label fw-bold text-warning small">Beskrivelsesskabelon</label>
                    <textarea id="talent-description"
                              class="form-control bg-dark text-white border-secondary"
                              rows="2"
                              required
                              @bind="_formModel.DescriptionFormat"
                              placeholder="Styrker kontrol med {0}%."></textarea>
                    <div class="form-text text-muted small">Brug <code>{0}</code> som pladsholder for rangværdien på det aktuelle niveau.</div>
                </div>

                <!-- Video URL -->
                <div class="col-12">
                    <label for="talent-video-url" class="form-label fw-bold text-warning small">Videolink (YouTube, Vimeo m.fl.)</label>
                    <input id="talent-video-url"
                           type="url"
                           autocapitalize="none"
                           autocorrect="off"
                           spellcheck="false"
                           class="form-control bg-dark text-white border-secondary"
                           @bind="_formModel.VideoUrl"
                           placeholder="https://www.youtube.com/watch?v=..." />
                    <div class="form-text text-muted small">Valgfrit link til videoinstruktion eller teknikgennemgang.</div>
                </div>

                <!-- Max Rank -->
                <div class="col-md-4">
                    <label for="talent-max-rank" class="form-label fw-bold text-warning small">Maks. rang</label>
                    <select id="talent-max-rank"
                            class="form-select bg-dark text-white border-secondary"
                            value="@_formModel.MaxRank"
                            @onchange="OnMaxRankSelected">
                        <option value="1">1 rang</option>
                        <option value="2">2 range</option>
                        <option value="3">3 range</option>
                        <option value="4">4 range</option>
                        <option value="5">5 range</option>
                    </select>
                </div>

                <!-- Comma-separated rank values -->
                <div class="col-md-4">
                    <label for="talent-rank-values" class="form-label fw-bold text-warning small">Rangværdier ({0})</label>
                    <input id="talent-rank-values"
                           type="text"
                           class="form-control bg-dark text-white border-secondary"
                           required
                           @bind="_formModel.RankValuesRaw"
                           placeholder="F.eks. 5, 10, 15" />
                    <div class="form-text text-muted small">Adskil med komma.</div>
                </div>

                <!-- Required Points in tree -->
                <div class="col-md-4">
                    <label for="talent-required-points" class="form-label fw-bold text-warning small">Pointkrav i træet</label>
                    <input id="talent-required-points"
                           type="number"
                           class="form-control bg-dark text-white border-secondary"
                           @bind="_formModel.RequiredPointsInTree"
                           min="0" max="50" />
                    <div class="form-text text-muted small">Tidligere investerede point.</div>
                </div>
            </div>
        </form>
    </ChildContent>
    <FooterContent>
        <div>
            @if (!_formModel.IsNew)
            {
                <button type="button" class="btn btn-outline-danger fw-bold d-flex align-items-center gap-1" @onclick="DeleteTalentAsync">
                    <span aria-hidden="true">🗑️</span> Slet talent
                </button>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">Annuller</button>
            <button type="submit" form="edit-talent-form" class="btn btn-warning fw-bold text-dark px-4">Gem talent</button>
        </div>
    </FooterContent>
</ModalDialog>

<!-- Achievements Showcase Modal -->
<ModalDialog IsOpen="_showAchievementsModal"
             OnClose="CloseAchievementsModal"
             Title="BJJ-trofæer og præstationer"
             DialogClass="bjj-dialog-lg bjj-dialog-dark"
             LightDismiss="true">
    <HeaderContent>
        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4" aria-hidden="true">🏆</span>
                <div>
                    <h2 class="bjj-dialog-title text-warning m-0">BJJ-trofæer og præstationer</h2>
                    <span class="text-muted small">Lås op for bedrifter ved at mestre grundlæggende BJJ</span>
                </div>
            </div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-2">
                @_totalAchievementPoints point (@_unlockedAchievementCount/@_achievements.Count)
            </span>
        </div>
    </HeaderContent>
    <ChildContent>
        <div class="row g-3">
            @foreach (var achievement in _achievements)
            {
                <div @key="achievement.Id" class="col-md-6">
                    <div class="trophy-card @(achievement.IsUnlocked ? "unlocked" : "locked") h-100">
                        <div class="trophy-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-3" aria-hidden="true">@achievement.Icon</span>
                                <div>
                                    <div class="trophy-card-title">@achievement.Title</div>
                                    <span class="badge bg-dark border border-secondary text-muted small" style="font-size: 0.65rem;">@achievement.Category</span>
                                </div>
                            </div>
                            <span class="trophy-points-badge">+@achievement.Points point</span>
                        </div>
                        <div class="trophy-card-desc">
                            @achievement.Description
                        </div>
                        <div class="trophy-card-footer">
                            @if (achievement.IsUnlocked)
                            {
                                <span><span aria-hidden="true">⭐</span> Låst op: @achievement.UnlockedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span><span aria-hidden="true">🔒</span> Låst</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-warning fw-bold px-4" @onclick="CloseAchievementsModal">Luk</button>
    </FooterContent>
</ModalDialog>

<ConfirmDialog IsOpen="_showResetDefaultsConfirm"
               Title="Nulstil til standardtræ"
               Message="Er du sikker på, at du vil nulstille til standardtræet for grundlæggende BJJ? Dette vil fjerne eventuelle brugerdefinerede talenter."
               ConfirmText="Nulstil træ"
               CancelText="Annuller"
               OnConfirm="ConfirmResetToDefaultsAsync"
               OnCancel="CancelResetToDefaults" />

