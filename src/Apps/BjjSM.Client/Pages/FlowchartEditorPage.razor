@page "/flowcharts/{Id:guid}"
@using System.Globalization

<PageTitle>@(string.IsNullOrWhiteSpace(_title) ? "Flowchart-editor" : _title) | BjjSM</PageTitle>

<h1 class="visually-hidden">@(string.IsNullOrWhiteSpace(_title) ? "Flowchart-editor" : $"{_title} - Flowchart-editor")</h1>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="color: var(--brand-blue, #20409A) !important;">
            <span class="visually-hidden">Indlæser flowchart...</span>
        </div>
        <p class="text-muted mt-2">Indlæser kampplan-lærred...</p>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="card border-0 shadow-sm p-4 m-4" role="alert" style="border-left: 5px solid #DC2626 !important; background-color: #FEF2F2;">
        <h2 class="h4 text-danger fw-bold"><span aria-hidden="true">⚠️</span> Fejl ved indlæsning af flowchart</h2>
        <p class="text-muted">@_errorMessage</p>
        <div>
            <a href="flowcharts" class="btn btn-outline-secondary">← Tilbage til flowcharts</a>
            <button type="button" class="btn btn-outline-danger ms-2" @onclick="LoadFlowchartAsync">Prøv igen</button>
        </div>
    </div>
}
else if (_flowchart is not null)
{
    <div class="flowchart-editor-container">
        <!-- Top Toolbar -->
        <div class="editor-toolbar bg-white border-bottom p-2 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <a href="flowcharts" class="btn btn-sm btn-outline-secondary" title="Tilbage til oversigten">
                    ← Tilbage
                </a>
                <div>
                    <label for="flowchart-title" class="visually-hidden">Titel på flowchart</label>
                    <input id="flowchart-title"
                           type="text"
                           class="form-control form-control-sm fw-bold border-0 bg-transparent fs-5 p-0"
                           style="max-width: 350px; color: #050505;"
                           @bind="_title" @bind:after="MarkDirty" placeholder="Titel på kampplan..." />
                </div>
                @if (_isDirty)
                {
                    <span class="badge bg-warning text-dark fw-bold">Ikke gemte ændringer</span>
                }
            </div>

            <!-- Canvas Action Controls -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-brand-primary d-flex align-items-center gap-1" @onclick="AddPositionNode">
                    <span aria-hidden="true">+</span> Tilføj position
                </button>

                <button type="button"
                        class="btn btn-sm @(_isConnectingMode ? "btn-warning fw-bold" : "btn-outline-primary")"
                        aria-pressed="@(_isConnectingMode ? "true" : "false")"
                        @onclick="ToggleConnectMode" title="Klik på startposition og derefter målposition for at tegne en pil">
                    @(_isConnectingMode ? (_selectedSourceNodeId.HasValue ? "⚡ Klik på målposition..." : "⚡ Vælg startposition...") : "🔗 Forbind pile")
                </button>

                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ZoomIn" title="Zoom ind" aria-label="Zoom ind">+</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetView" title="Nulstil visning" aria-label="Nulstil zoom og visning">
                        @(Math.Round(_zoom * 100))%
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ZoomOut" title="Zoom ud" aria-label="Zoom ud">−</button>
                </div>

                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ExportJsonAsync" title="Eksporter som JSON">
                        Eksporter JSON
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ExportSvgAsync" title="Download SVG-billede">
                        Download SVG
                    </button>
                    <label for="flowchart-import-json" class="btn btn-outline-secondary mb-0" title="Importer JSON-fil" style="cursor: pointer;">
                        Importer JSON
                        <InputFile id="flowchart-import-json" OnChange="ImportJsonAsync" class="visually-hidden" accept=".json" />
                    </label>
                </div>

                <button type="button" class="btn btn-sm btn-success px-3 fw-bold" @onclick="SaveFlowchartAsync" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Gemmer...</span>
                    }
                    else
                    {
                        <span><span aria-hidden="true">💾</span> Gem</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="alert alert-info alert-dismissible m-2 mb-0 py-2" role="status" aria-live="polite">
                <span>@_notificationMessage</span>
                <button type="button" class="btn-close" aria-label="Luk" @onclick="() => _notificationMessage = null"></button>
            </div>
        }

        <!-- Interactive Canvas Area -->
        <div class="canvas-wrapper position-relative overflow-hidden"
             style="background-color: #F8FAFC; background-image: radial-gradient(#CBD5E1 1px, transparent 1px); background-size: 24px 24px; touch-action: none; overscroll-behavior: none; user-select: none; -webkit-user-select: none; flex: 1 1 0; min-height: 0; width: 100%; height: 100%; position: relative; overflow: hidden;"
             @onpointerdown="OnCanvasPointerDown"
             @onpointermove="OnCanvasPointerMove"
             @onpointerup="OnCanvasPointerUp"
             @onpointercancel="OnCanvasPointerCancel"
             @onwheel="OnCanvasWheel">

            <svg id="bjj-flowchart-svg" class="w-100 h-100 position-absolute" style="top: 0; left: 0; touch-action: none; cursor: @(_isConnectingMode ? "crosshair" : (_isPanning ? "grabbing" : "grab")); user-select: none;">
                <defs>
                    <!-- Arrow markers -->
                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" fill="#20409A" />
                    </marker>
                    <marker id="arrowhead-gold" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" fill="#B38F00" />
                    </marker>
                    <marker id="arrowhead-selected" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" fill="#EF4444" />
                    </marker>
                </defs>

                <!-- Canvas transformation group -->
                @{
                    var edgeLayouts = FlowchartLayoutEngine.ComputeEdgeLayouts(_nodes, _edges);
                }
                <g transform="translate(@(_panX.ToString(CultureInfo.InvariantCulture)), @(_panY.ToString(CultureInfo.InvariantCulture))) scale(@(_zoom.ToString(CultureInfo.InvariantCulture)))">

                    <!-- Layer 1: Arrow Paths -->
                    @foreach (var edge in _edges)
                    {
                        if (!edgeLayouts.TryGetValue(edge.Id, out var edgeLayout) || string.IsNullOrEmpty(edgeLayout.PathData))
                        {
                            continue;
                        }

                        var isSelected = _selectedEdge?.Id == edge.Id;
                        var isSubmission = edge.Type == 3;
                        var strokeColor = isSelected ? "#EF4444" : (isSubmission ? "#B38F00" : "#20409A");
                        var markerId = isSelected ? "url(#arrowhead-selected)" : (isSubmission ? "url(#arrowhead-gold)" : "url(#arrowhead)");

                        <g @key="@($"edge-path-{edge.Id}")"
                           class="flowchart-edge"
                           tabindex="0"
                           role="button"
                           aria-label="@($"Overgang: {edge.Label}")"
                           style="cursor: pointer;"
                           @onclick="() => SelectEdge(edge)"
                           @onclick:stopPropagation="true"
                           @onkeydown="(e) => HandleEdgeKeyDown(edge, e)"
                           @onkeydown:stopPropagation="true">
                            <!-- Background thick line for easy clicking & touch tapping -->
                            <path d="@edgeLayout.PathData" fill="none" stroke="transparent" stroke-width="32" pointer-events="stroke" />

                            <!-- Actual edge stroke -->
                            <path d="@edgeLayout.PathData"
                                  fill="none"
                                  stroke="@strokeColor"
                                  stroke-width="@(isSelected ? "3.5" : "2.5")"
                                  stroke-dasharray="@(edge.Type == 4 ? "4 4" : "none")"
                                  marker-end="@markerId" />
                        </g>
                    }

                    <!-- Layer 2: Position Nodes -->
                    @foreach (var node in _nodes)
                    {
                        var isSelected = _selectedNode?.Id == node.Id;
                        var isConnectingSource = _selectedSourceNodeId == node.Id;
                        var isSubmissionNode = node.Category == 4;
                        var headerColor = isSubmissionNode ? "#FFEE00" : "#20409A";
                        var headerTextColor = isSubmissionNode ? "#050505" : "#FFFFFF";
                        var borderColor = isSelected ? "#EF4444" : (isConnectingSource ? "#F59E0B" : (isSubmissionNode ? "#FFD700" : "#20409A"));

                        <g @key="node.Id"
                           class="flowchart-node"
                           tabindex="0"
                           role="button"
                           aria-label="@($"Position: {node.Title} ({GetCategoryDisplayName(node.Category)})")"
                           transform="translate(@(node.X.ToString(CultureInfo.InvariantCulture)), @(node.Y.ToString(CultureInfo.InvariantCulture)))"
                           style="touch-action: none; cursor: @(_isConnectingMode ? "crosshair" : "move");"
                           @onpointerdown="(e) => OnNodePointerDown(node, e)"
                           @onpointerdown:stopPropagation="true"
                           @onclick="() => HandleNodeClick(node)"
                           @onclick:stopPropagation="true"
                           @onkeydown="(e) => HandleNodeKeyDown(node, e)"
                           @onkeydown:stopPropagation="true">

                            <!-- Node Container Card -->
                            <rect width="@(node.Width.ToString(CultureInfo.InvariantCulture))"
                                  height="@(node.Height.ToString(CultureInfo.InvariantCulture))"
                                  rx="8"
                                  fill="#FFFFFF"
                                  stroke="@borderColor"
                                  stroke-width="@(isSelected || isConnectingSource ? "3" : "2")"
                                  filter="drop-shadow(0 4px 6px rgba(0, 0, 0, 0.08))" />

                            <!-- Header Bar -->
                            <path d="M 0 8 Q 0 0 8 0 L @((node.Width - 8).ToString(CultureInfo.InvariantCulture)) 0 Q @(node.Width.ToString(CultureInfo.InvariantCulture)) 0 @(node.Width.ToString(CultureInfo.InvariantCulture)) 8 L @(node.Width.ToString(CultureInfo.InvariantCulture)) 26 L 0 26 Z"
                                  fill="@headerColor" />

                            <!-- Category Badge text -->
                            <text x="8" y="18" font-size="10" font-weight="700" fill="@headerTextColor" letter-spacing="0.5">
                                @GetCategoryDisplayName(node.Category).ToUpperInvariant()
                            </text>

                            <!-- Node Title -->
                            <text x="10" y="48" font-size="13" font-weight="700" fill="#050505">
                                @TruncateText(node.Title, (int)(node.Width / 8))
                            </text>

                            <!-- Node Notes snippet -->
                            @if (!string.IsNullOrWhiteSpace(node.Notes))
                            {
                                <g>
                                    <text x="10" y="66" font-size="10" fill="#64748B">
                                        @TruncateText(node.Notes, (int)(node.Width / 7))
                                    </text>
                                </g>
                            }

                            <!-- Connecting Port Indicator -->
                            @if (_isConnectingMode)
                            {
                                <circle cx="@((node.Width / 2).ToString(CultureInfo.InvariantCulture))" cy="@(node.Height.ToString(CultureInfo.InvariantCulture))"
                                        r="6" fill="#F59E0B" stroke="#FFFFFF" stroke-width="2" />
                            }
                        </g>
                    }

                    <!-- Layer 3: Arrow Label Pills & Leader Lines (always above nodes) -->
                    @foreach (var edge in _edges)
                    {
                        if (!edgeLayouts.TryGetValue(edge.Id, out var layout) || string.IsNullOrEmpty(layout.PathData))
                        {
                            continue;
                        }

                        var isSelected = _selectedEdge?.Id == edge.Id;
                        var isSubmission = edge.Type == 3;
                        var strokeColor = isSelected ? "#EF4444" : (isSubmission ? "#B38F00" : "#20409A");

                        <g @key="@($"edge-label-{edge.Id}")"
                           class="flowchart-edge-label"
                           tabindex="0"
                           role="button"
                           aria-label="@($"Overgang: {edge.Label}")"
                           style="cursor: pointer;"
                           @onclick="() => SelectEdge(edge)"
                           @onclick:stopPropagation="true"
                           @onkeydown="(e) => HandleEdgeKeyDown(edge, e)"
                           @onkeydown:stopPropagation="true">
                            @if (layout.HasLeaderLine)
                            {
                                <line x1="@(layout.AnchorX.ToString("F1", CultureInfo.InvariantCulture))"
                                      y1="@(layout.AnchorY.ToString("F1", CultureInfo.InvariantCulture))"
                                      x2="@(layout.LabelX.ToString("F1", CultureInfo.InvariantCulture))"
                                      y2="@(layout.LabelY.ToString("F1", CultureInfo.InvariantCulture))"
                                      stroke="@strokeColor"
                                      stroke-width="1"
                                      stroke-dasharray="3 3"
                                      opacity="0.65" />
                            }

                            <g transform="translate(@(layout.LabelX.ToString(CultureInfo.InvariantCulture)), @(layout.LabelY.ToString(CultureInfo.InvariantCulture)))">
                                <rect x="@((-layout.PillWidth / 2).ToString(CultureInfo.InvariantCulture))"
                                      y="@((-layout.PillHeight / 2).ToString(CultureInfo.InvariantCulture))"
                                      width="@(layout.PillWidth.ToString(CultureInfo.InvariantCulture))"
                                      height="@(layout.PillHeight.ToString(CultureInfo.InvariantCulture))"
                                      rx="12"
                                      fill="@(isSelected ? "#FEE2E2" : (isSubmission ? "#FFFBEB" : "#FFFFFF"))"
                                      stroke="@strokeColor"
                                      stroke-width="1.5" />
                                <text x="0" y="4" text-anchor="middle" font-size="11" font-weight="700"
                                      fill="@(isSelected ? "#DC2626" : (isSubmission ? "#997A00" : "#050505"))">
                                    @edge.Label
                                </text>
                            </g>
                        </g>
                    }
                </g>
            </svg>

            <!-- Mode Banner / Hint Overlay -->
            @if (_isConnectingMode)
            {
                <div class="position-absolute top-0 start-50 translate-middle-x mt-3 bg-dark text-white px-3 py-1 rounded-pill shadow-sm small fw-bold d-flex align-items-center gap-2" role="status" aria-live="polite">
                    <span><span aria-hidden="true">⚡</span> @(_selectedSourceNodeId.HasValue ? "Klik nu på målpositionen for at oprette overgang" : "Klik på startpositionen")</span>
                    <button type="button" class="btn btn-sm btn-link text-warning p-0 text-decoration-none" @onclick="ToggleConnectMode">Annuller</button>
                </div>
            }
        </div>

        <!-- Selected Element Inspector Panel / Bottom Drawer -->
        @if (_selectedNode is not null)
        {
            <div class="border-top bg-white p-3 shadow-lg position-relative">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 fw-bold m-0 text-primary"><span aria-hidden="true">📌</span> Rediger position: @_selectedNode.Title</h2>
                    <button type="button" class="btn-close btn-sm" aria-label="Luk" @onclick="() => _selectedNode = null"></button>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="node-title-input" class="form-label small fw-bold text-muted mb-1">POSITIONSTITEL</label>
                        <input id="node-title-input" type="text" class="form-control form-control-sm" @bind="_selectedNode.Title" @bind:after="MarkDirty" />
                    </div>
                    <div class="col-md-2">
                        <label for="node-category-select" class="form-label small fw-bold text-muted mb-1">KATEGORI</label>
                        <select id="node-category-select" class="form-select form-select-sm" @bind="_selectedNode.Category" @bind:after="MarkDirty">
                            <option value="1">Topkontrol</option>
                            <option value="2">Bundguard</option>
                            <option value="3">Neutral</option>
                            <option value="4">Submission-afslutning</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label for="node-notes-input" class="form-label small fw-bold text-muted mb-1">TRÆNERNOTER / NØGLEPUNKTER</label>
                        <input id="node-notes-input" type="text" class="form-control form-control-sm" placeholder="F.eks. Underhook-prioritet, hoftepres" @bind="_selectedNode.Notes" @bind:after="MarkDirty" />
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger w-100" @onclick="() => DeleteNode(_selectedNode.Id)">
                            Slet position
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (_selectedEdge is not null)
        {
            <div class="border-top bg-white p-3 shadow-lg position-relative">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 fw-bold m-0 text-primary"><span aria-hidden="true">🔗</span> Rediger overgang: @_selectedEdge.Label</h2>
                    <button type="button" class="btn-close btn-sm" aria-label="Luk" @onclick="() => _selectedEdge = null"></button>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="edge-label-input" class="form-label small fw-bold text-muted mb-1">OVERGANG / TEKNIK</label>
                        <input id="edge-label-input" type="text" class="form-control form-control-sm" @bind="_selectedEdge.Label" @bind:after="MarkDirty" />
                    </div>
                    <div class="col-md-2">
                        <label for="edge-type-select" class="form-label small fw-bold text-muted mb-1">OVERGANGSTYPE</label>
                        <select id="edge-type-select" class="form-select form-select-sm" @bind="_selectedEdge.Type" @bind:after="MarkDirty">
                            <option value="1">Sweep</option>
                            <option value="2">Guard-passering</option>
                            <option value="3">Submission-angreb</option>
                            <option value="4">Undvigelse / Escape</option>
                            <option value="5">Kontring / Reversal</option>
                            <option value="6">Overgang</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="edge-notes-input" class="form-label small fw-bold text-muted mb-1">TRÆNERNOTER</label>
                        <input id="edge-notes-input" type="text" class="form-control form-control-sm" placeholder="F.eks. Eksplosiv bro, bryd kropsholdning" @bind="_selectedEdge.Notes" @bind:after="MarkDirty" />
                    </div>
                    <div class="col-md-2">
                        <label for="edge-curve-input" class="form-label small fw-bold text-muted mb-1">KURVEFORSKYDNING: @(_selectedEdge.CurveOffset)px</label>
                        <input id="edge-curve-input" type="range" class="form-range" min="-120" max="120" step="5" @bind="_selectedEdge.CurveOffset" @bind:after="MarkDirty" />
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger w-100" @onclick="() => DeleteEdge(_selectedEdge.Id)">
                            Slet pil
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
