@inject IMemberApiClient MemberApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<ModalDialog IsOpen="@(IsOpen && Member is not null)"
             OnClose="Close"
             Title="🎓 Tildel bælte- eller stribegraduering"
             LightDismiss="false">
    <ChildContent>
        <form id="promote-member-form" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div id="promote-member-error" class="alert alert-danger py-2 small" role="alert">
                    @_errorMessage
                </div>
            }

            @if (Member is not null)
            {
                <div class="p-3 mb-3 rounded" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                    <div class="fw-bold text-dark">Graduerer: @Member.FirstName @Member.LastName</div>
                    <div class="small text-muted mt-1">
                        Nuværende grad: <span class="fw-semibold text-dark">@Member.CurrentRank.BeltName @(Member.CurrentRank.Stripes > 0 ? $"({Member.CurrentRank.Stripes} {(Member.CurrentRank.Stripes == 1 ? "stribe" : "striber")})" : "")</span>
                    </div>
                </div>
            }

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="promote-member-ladder" class="form-label fw-bold text-dark small">Nyt bæltesystem</label>
                    <select id="promote-member-ladder" class="form-select" @bind="_ladder" @bind:after="OnLadderChanged">
                        <option value="@BeltLadder.Adult">Voksen</option>
                        <option value="@BeltLadder.Kids">Børn</option>
                    </select>
                </div>
                <div class="col-6">
                    <label for="promote-member-belt" class="form-label fw-bold text-dark small">Ny bæltegrad</label>
                    @if (_ladder == BeltLadder.Adult)
                    {
                        <select id="promote-member-belt" class="form-select" @bind="_adultBelt" @bind:after="OnBeltChanged">
                            @foreach (var belt in Enum.GetValues<AdultBelt>())
                            {
                                <option value="@belt">@FormatAdultBelt(belt)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="promote-member-belt" class="form-select" @bind="_kidsBelt" @bind:after="OnBeltChanged">
                            @foreach (var belt in Enum.GetValues<KidsBelt>())
                            {
                                <option value="@belt">@belt bælte</option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label for="promote-member-stripes" class="form-label fw-bold text-dark small">
                    @(_ladder == BeltLadder.Adult && (_adultBelt == AdultBelt.Black || _adultBelt == AdultBelt.Coral || _adultBelt == AdultBelt.Red) ? "Grader" : "Striber / grader"): @_stripes
                </label>
                <input id="promote-member-stripes" type="range" class="form-range" min="@MinStripes" max="@MaxStripes" step="1" @bind="_stripes" />
                <div class="d-flex justify-content-between text-muted small px-1">
                    @for (int i = MinStripes; i <= MaxStripes; i++)
                    {
                        <span>@i</span>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label for="promote-member-date" class="form-label fw-bold text-dark small">Gradueringsdato</label>
                <input id="promote-member-date"
                       @ref="_dateInput"
                       type="date"
                       class="form-control"
                       @bind="_awardedAt"
                       required
                       aria-invalid="@(_dateHasError ? "true" : null)"
                       aria-describedby="@(_dateHasError ? "promote-member-error" : null)" />
            </div>

            <div class="mb-3">
                <label for="promote-member-notes" class="form-label fw-bold text-dark small">Instruktørnoter / graduering</label>
                <textarea id="promote-member-notes" class="form-control" rows="2" @bind="_notes" placeholder="f.eks. Stærk open guard-retention, bestod gradueringssparring"></textarea>
            </div>
        </form>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="Close">Annuller</button>
        <button type="submit" form="promote-member-form" class="btn btn-brand-primary" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Gemmer...</span>
            }
            else
            {
                <span>Tildel graduering</span>
            }
        </button>
    </FooterContent>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MemberDto? Member { get; set; }
    [Parameter] public EventCallback<MemberDto> OnMemberPromoted { get; set; }

    private BeltLadder _ladder = BeltLadder.Adult;
    private AdultBelt _adultBelt = AdultBelt.White;
    private KidsBelt _kidsBelt = KidsBelt.White;
    private int _stripes = 0;
    private DateTime _awardedAt = DateTime.UtcNow;
    private string? _notes;
    private string? _errorMessage;
    private bool _dateHasError;
    private bool _isSaving;
    private ElementReference _dateInput;
    private IJSObjectReference? _interopModule;

    private int MinStripes => (_ladder, _adultBelt) switch
    {
        (BeltLadder.Adult, AdultBelt.Coral) => 7,
        (BeltLadder.Adult, AdultBelt.Red) => 9,
        _ => 0
    };

    private int MaxStripes => (_ladder, _adultBelt) switch
    {
        (BeltLadder.Adult, AdultBelt.Black) => 6,
        (BeltLadder.Adult, AdultBelt.Coral) => 8,
        (BeltLadder.Adult, AdultBelt.Red) => 10,
        _ => 4
    };

    private static string FormatAdultBelt(AdultBelt belt) => belt switch
    {
        AdultBelt.White => "Hvidt bælte",
        AdultBelt.Blue => "Blåt bælte",
        AdultBelt.Purple => "Lilla bælte",
        AdultBelt.Brown => "Brunt bælte",
        AdultBelt.Black => "Sort bælte",
        AdultBelt.Coral => "Koralbælte",
        AdultBelt.Red => "Rødt bælte",
        _ => $"{belt} bælte"
    };

    protected override void OnParametersSet()
    {
        if (Member is not null)
        {
            _ladder = Member.CurrentRank.Ladder;
            if (_ladder == BeltLadder.Adult && Member.CurrentRank.Belt.HasValue)
                _adultBelt = Member.CurrentRank.Belt.Value;
            else if (_ladder == BeltLadder.Kids && Member.CurrentRank.KidsBelt.HasValue)
                _kidsBelt = Member.CurrentRank.KidsBelt.Value;

            _stripes = Member.CurrentRank.Stripes;
            ClampStripes();
        }
    }

    private void OnLadderChanged()
    {
        _adultBelt = AdultBelt.White;
        _kidsBelt = KidsBelt.White;
        ClampStripes();
    }

    private void OnBeltChanged()
    {
        ClampStripes();
    }

    private void ClampStripes()
    {
        var min = MinStripes;
        var max = MaxStripes;
        if (_stripes < min) _stripes = min;
        if (_stripes > max) _stripes = max;
    }

    private async Task Close()
    {
        _errorMessage = null;
        _dateHasError = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmitAsync()
    {
        if (Member is null) return;

        _errorMessage = null;
        _dateHasError = false;

        if (_awardedAt == default)
        {
            _dateHasError = true;
            _errorMessage = "Gradueringsdato er påkrævet.";
            await FocusElementAsync(_dateInput);
            return;
        }

        _isSaving = true;

        try
        {
            var req = new PromoteMemberRequest(
                Ladder: _ladder,
                AdultBelt: _ladder == BeltLadder.Adult ? _adultBelt : null,
                KidsBelt: _ladder == BeltLadder.Kids ? _kidsBelt : null,
                Stripes: _stripes,
                AwardedAt: _awardedAt,
                AwardedBy: Guid.NewGuid(),
                Notes: string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
            );

            var result = await MemberApi.PromoteMemberAsync(Member.Id, req);
            if (result.IsFailure)
            {
                _errorMessage = result.Error;
                return;
            }

            await OnMemberPromoted.InvokeAsync(result.Value);
            await Close();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FocusElementAsync(ElementReference element)
    {
        try
        {
            _interopModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-interop.js");
            await _interopModule.InvokeVoidAsync("focusElement", element);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_interopModule is not null)
        {
            try
            {
                await _interopModule.DisposeAsync();
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _interopModule = null;
        }
    }
}
