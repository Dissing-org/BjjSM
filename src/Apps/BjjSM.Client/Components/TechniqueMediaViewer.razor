@namespace BjjSM.Client.Components
@using BjjSM.Modules.Curriculum.Domain

@{
    var effectiveVideoUrl = VideoUrl;
    var parsedVideo = !string.IsNullOrWhiteSpace(effectiveVideoUrl) ? MediaUrlParser.Parse(effectiveVideoUrl) : null;
    var candidateImageUrl = !string.IsNullOrWhiteSpace(ImageUrl)
        ? ImageUrl
        : (parsedVideo?.Provider == MediaProvider.ImageOrGif ? parsedVideo.CleanUrl : null);
    var effectiveImageUrl = SafeUrlValidator.IsSafeMediaUrl(candidateImageUrl) ? candidateImageUrl!.Trim() : null;
    var parsedPreviewMedia = !string.IsNullOrWhiteSpace(effectiveImageUrl) ? MediaUrlParser.Parse(effectiveImageUrl) : null;
    var isPreviewVideo = parsedPreviewMedia?.Provider is MediaProvider.DirectVideo or MediaProvider.LocalServerVideo;
    var effectiveCaptionsUrl = SafeUrlValidator.IsSafeMediaUrl(CaptionsUrl) ? CaptionsUrl!.Trim() : null;
}

@if (parsedVideo != null && parsedVideo.Provider == MediaProvider.YouTube && !string.IsNullOrWhiteSpace(parsedVideo.EmbedUrl))
{
    <div class="technique-video-container mb-3">
        <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden" style="border: 2px solid #20409A;">
            <iframe src="@parsedVideo.EmbedUrl"
                    title="@TechniqueTitle"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    sandbox="allow-scripts allow-same-origin allow-presentation"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; focus-without-user-activation 'none'"
                    allowfullscreen>
            </iframe>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1 px-1">
            <span class="badge" style="background-color: #EBF0FA; color: #20409A; font-weight: 700; border: 1px solid #20409A;">
                ▶ YouTube-demonstration
            </span>
            @if (parsedVideo.StartSeconds.HasValue || parsedVideo.EndSeconds.HasValue)
            {
                <span class="small text-muted font-monospace">
                    ⏱ Interval: @(parsedVideo.StartSeconds ?? 0)s - @(parsedVideo.EndSeconds.HasValue ? parsedVideo.EndSeconds.Value.ToString() + "s" : "slut")
                </span>
            }
        </div>
    </div>
}
else if (parsedVideo != null && (parsedVideo.Provider == MediaProvider.DirectVideo || parsedVideo.Provider == MediaProvider.LocalServerVideo) && !string.IsNullOrWhiteSpace(parsedVideo.EmbedUrl))
{
    <div class="technique-video-container mb-3 text-center">
        <video controls muted loop playsinline preload="none" width="640" height="360" class="rounded shadow-sm w-100" style="max-height: 400px; border: 2px solid #20409A; background-color: #050505;">
            <source src="@parsedVideo.EmbedUrl" type="@GetVideoMimeType(parsedVideo.CleanUrl)" />
            @if (!string.IsNullOrWhiteSpace(effectiveCaptionsUrl))
            {
                <track kind="captions" src="@effectiveCaptionsUrl" srclang="da" label="Dansk" />
            }
            @* Undertekster (<track kind="captions" srclang="da" label="Dansk" />) tilføjes når CaptionsUrl er angivet *@
            Din browser understøtter ikke videoafspilning.
        </video>
        <div class="d-flex justify-content-between align-items-center mt-1 px-1">
            <span class="badge" style="background-color: #FFEE00; color: #050505; font-weight: 700; border: 1px solid #050505;">
                @(parsedVideo.Provider == MediaProvider.LocalServerVideo ? "🏛 Lokal servervideo" : "📹 Videostream")
            </span>
            @if (parsedVideo.StartSeconds.HasValue || parsedVideo.EndSeconds.HasValue)
            {
                <span class="small text-muted font-monospace">
                    ⏱ Interval: @(parsedVideo.StartSeconds ?? 0)s - @(parsedVideo.EndSeconds.HasValue ? parsedVideo.EndSeconds.Value.ToString() + "s" : "slut")
                </span>
            }
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
{
    <div class="technique-media-container mt-2">
        <button type="button"
                class="technique-thumbnail-card"
                @onclick="OpenLightbox"
                aria-label="@($"Åbn medieforhåndsvisning for {TechniqueTitle}")"
                title="Klik for at se teknikdemonstrationen i fuld skærm">
            @if (isPreviewVideo)
            {
                <video muted loop playsinline preload="none" width="320" height="180" class="technique-gif-img" aria-hidden="true">
                    @if (GetBundledWebmCompanion(effectiveImageUrl) is { } webmThumbUrl)
                    {
                        <source src="@webmThumbUrl" type="video/webm" />
                    }
                    <source src="@effectiveImageUrl" type="@GetVideoMimeType(effectiveImageUrl)" />
                </video>
            }
            else
            {
                <img src="@effectiveImageUrl" alt="@TechniqueTitle" width="320" height="180" class="technique-gif-img" loading="lazy" />
            }
            <div class="technique-zoom-overlay">
                <span class="badge" style="background-color: #FFEE00; color: #050505; font-weight: 800; border: 1px solid #050505;">
                    🔍 FORSTØR
                </span>
            </div>
        </button>
    </div>
}

<ModalDialog IsOpen="@(_isLightboxOpen && !string.IsNullOrWhiteSpace(effectiveImageUrl))"
             OnClose="CloseLightbox"
             Title="@($"🥋 {TechniqueTitle}")"
             DialogClass="bjj-dialog-lightbox"
             FooterClass="justify-content-between"
             LightDismiss="true">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(effectiveImageUrl))
        {
            @if (isPreviewVideo)
            {
                <video controls muted loop playsinline preload="none" width="640" height="360" class="img-fluid technique-lightbox-img">
                    @if (GetBundledWebmCompanion(effectiveImageUrl) is { } webmModalUrl)
                    {
                        <source src="@webmModalUrl" type="video/webm" />
                    }
                    <source src="@effectiveImageUrl" type="@GetVideoMimeType(effectiveImageUrl)" />
                    @if (!string.IsNullOrWhiteSpace(effectiveCaptionsUrl))
                    {
                        <track kind="captions" src="@effectiveCaptionsUrl" srclang="da" label="Dansk" />
                    }
                    Din browser understøtter ikke videoafspilning.
                </video>
            }
            else
            {
                <img src="@effectiveImageUrl" alt="@TechniqueTitle" width="640" height="360" class="img-fluid technique-lightbox-img" />
            }
        }
    </ChildContent>
    <FooterContent>
        <span class="small text-muted">Kontinuerlig sløjfe &bull; Biomekanisk kampsportsdemonstration</span>
        <button type="button" class="btn btn-sm btn-outline-dark fw-bold" @onclick="CloseLightbox">Luk</button>
    </FooterContent>
</ModalDialog>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? VideoUrl { get; set; }
    [Parameter] public string? CaptionsUrl { get; set; }
    [Parameter] public string TechniqueTitle { get; set; } = "BJJ-teknik";

    private bool _isLightboxOpen;

    private void OpenLightbox() => _isLightboxOpen = true;
    private void CloseLightbox() => _isLightboxOpen = false;

    private static string? GetBundledWebmCompanion(string url)
    {
        var pathOnly = url.Split('?', '#')[0];
        return pathOnly.StartsWith("images/techniques/", StringComparison.OrdinalIgnoreCase)
            && pathOnly.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)
                ? pathOnly[..^4] + ".webm"
                : null;
    }

    private static string GetVideoMimeType(string url)
    {
        var pathOnly = url.Split('?', '#')[0];
        return pathOnly.EndsWith(".webm", StringComparison.OrdinalIgnoreCase)
            ? "video/webm"
            : pathOnly.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase)
                ? "video/ogg"
                : "video/mp4";
    }
}
