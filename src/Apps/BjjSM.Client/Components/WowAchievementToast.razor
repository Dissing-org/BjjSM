@using BjjSM.Client.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Current is not null)
{
    <div class="wow-achievement-toast" role="status" aria-live="polite">
        <div class="wow-achievement-shield">
            <span class="wow-shield-icon" aria-hidden="true">🛡️</span>
            <span class="wow-achievement-points">@Current.Points</span>
        </div>
        <div class="wow-achievement-content">
            <div class="wow-achievement-category-header">PRÆSTATION OPNÅET!</div>
            <div class="wow-achievement-title">
                <span class="wow-achievement-icon" aria-hidden="true">@Current.Icon</span>
                <span>@Current.Title</span>
            </div>
            <div class="wow-achievement-description">@Current.Description</div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button type="button"
                    class="wow-achievement-close-btn"
                    @onclick="ToggleMuteAsync"
                    aria-pressed="@(_isMuted ? "true" : "false")"
                    aria-label="@(_isMuted ? "Slå fanfare til" : "Slå fanfare fra")"
                    title="@(_isMuted ? "Slå fanfare til" : "Slå fanfare fra")">
                <span aria-hidden="true">@(_isMuted ? "🔇" : "🔊")</span>
            </button>
            <button type="button"
                    class="wow-achievement-close-btn"
                    @onclick="DismissAsync"
                    aria-label="Luk">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    </div>
}

@code {
    private const string MuteStorageKey = "bjjsm_mute_fanfare";

    [Parameter] public Achievement? Current { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private string? _lastShownId;
    private bool _isMuted;
    private bool _mutePreferenceLoaded;
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _interopModule;

    protected override async Task OnParametersSetAsync()
    {
        if (Current is not null && Current.Id != _lastShownId)
        {
            _lastShownId = Current.Id;
            if (_cts is not null)
            {
                await _cts.CancelAsync();
                _cts.Dispose();
            }
            _cts = new CancellationTokenSource();
            var token = _cts.Token;

            await PlayFanfareAsync();

            _ = AutoDismissAfterDelayAsync(token);
        }
        else if (Current is null)
        {
            _lastShownId = null;
            if (_cts is not null)
            {
                await _cts.CancelAsync();
                _cts.Dispose();
                _cts = null;
            }
        }
    }

    private async Task AutoDismissAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(5000, token);
            if (!token.IsCancellationRequested)
            {
                await DismissAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when toast is dismissed early or replaced
        }
    }

    private async Task<bool> LoadMutePreferenceAsync()
    {
        try
        {
            var value = await JS.InvokeAsync<string?>("localStorage.getItem", MuteStorageKey);
            return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private async Task ToggleMuteAsync()
    {
        _isMuted = !_isMuted;
        _mutePreferenceLoaded = true;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", MuteStorageKey, _isMuted ? "true" : "false");
        }
        catch
        {
            // Ignore storage failures in test/restricted environments
        }
    }

    private async Task PlayFanfareAsync()
    {
        if (!_mutePreferenceLoaded)
        {
            _isMuted = await LoadMutePreferenceAsync();
            _mutePreferenceLoaded = true;
        }

        if (_isMuted)
        {
            return;
        }

        try
        {
            _interopModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-interop.js");
            await _interopModule.InvokeVoidAsync("playAchievementFanfare");
        }
        catch
        {
            // Ignore audio playback failures in test/restricted environments
        }
    }

    private async Task DismissAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }
        _lastShownId = null;
        if (OnDismiss.HasDelegate)
        {
            await OnDismiss.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }

        if (_interopModule is not null)
        {
            try
            {
                await _interopModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            _interopModule = null;
        }
    }
}
