@inject ICurriculumApiClient CurriculumApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<ModalDialog IsOpen="IsOpen"
             OnClose="Close"
             Title="@($"🥋 Tilføj uge {WeekNumber} øvelse / teknik")"
             LightDismiss="false">
    <ChildContent>
        <form id="add-technique-form" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div id="add-technique-error" class="alert alert-danger py-2 small" role="alert">
                    @_errorMessage
                </div>
            }

            <div class="mb-3">
                <label for="add-technique-title" class="form-label fw-bold text-dark small">Titel på teknik / øvelse</label>
                <input id="add-technique-title"
                       @ref="_titleInput"
                       type="text"
                       class="form-control"
                       @bind="_title"
                       placeholder="f.eks. Scissor Sweep til Mount"
                       required
                       aria-invalid="@(_titleHasError ? "true" : null)"
                       aria-describedby="@(_titleHasError ? "add-technique-error" : null)" />
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="add-technique-category" class="form-label fw-bold text-dark small">Kategori</label>
                    <select id="add-technique-category" class="form-select" @bind="_category">
                        <option value="@TechniqueCategory.Technique">🥋 Teknik</option>
                        <option value="@TechniqueCategory.SituationalDrill">⚡ Situationsøvelse</option>
                        <option value="@TechniqueCategory.Warmup">🔥 Opvarmning</option>
                        <option value="@TechniqueCategory.CoolDown">🧘 Nedkøling</option>
                    </select>
                </div>
                <div class="col-6">
                    <label for="add-technique-sort" class="form-label fw-bold text-dark small">Rækkefølge</label>
                    <input id="add-technique-sort" type="number" class="form-control" @bind="_sortOrder" min="1" max="20" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="add-technique-url" class="form-label fw-bold text-dark small">Referencevideo-URL (valgfri)</label>
                <input id="add-technique-url"
                       @ref="_referenceUrlInput"
                       type="url"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       class="form-control"
                       @bind="_referenceUrl"
                       placeholder="https://youtube.com/watch?v=..."
                       aria-invalid="@(_urlHasError ? "true" : null)"
                       aria-describedby="@(_urlHasError ? "add-technique-error" : null)" />
            </div>

            <div class="mb-3">
                <label for="add-technique-notes" class="form-label fw-bold text-dark small">Trænernoter / fokuspunkter</label>
                <textarea id="add-technique-notes" class="form-control" rows="3" @bind="_coachingNotes" placeholder="f.eks. Hold ærmegrebet fast mod hoften, træk det nederste ben hurtigt..."></textarea>
            </div>
        </form>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="Close">Annuller</button>
        <button type="submit" form="add-technique-form" class="btn btn-brand-primary" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Tilføjer...</span>
            }
            else
            {
                <span>Tilføj teknik</span>
            }
        </button>
    </FooterContent>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid PlanId { get; set; }
    [Parameter] public int WeekNumber { get; set; }
    [Parameter] public EventCallback<MonthlyPlanDto> OnTechniqueAdded { get; set; }

    private string _title = "";
    private TechniqueCategory _category = TechniqueCategory.Technique;
    private string? _coachingNotes;
    private string? _referenceUrl;
    private int _sortOrder = 1;
    private string? _errorMessage;
    private bool _titleHasError;
    private bool _urlHasError;
    private bool _isSaving;
    private ElementReference _titleInput;
    private ElementReference _referenceUrlInput;
    private IJSObjectReference? _interopModule;

    private async Task Close()
    {
        _errorMessage = null;
        _titleHasError = false;
        _urlHasError = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _titleHasError = false;
        _urlHasError = false;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _titleHasError = true;
            _errorMessage = "Titel på teknik er påkrævet.";
            await FocusElementAsync(_titleInput);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_referenceUrl) && !SafeUrlValidator.IsSafeExternalUrl(_referenceUrl))
        {
            _urlHasError = true;
            _errorMessage = "Reference-URL skal være en gyldig http:// eller https:// adresse.";
            await FocusElementAsync(_referenceUrlInput);
            return;
        }

        _isSaving = true;

        try
        {
            var req = new AddTechniqueRequest(
                Title: _title.Trim(),
                Category: _category,
                CoachingNotes: string.IsNullOrWhiteSpace(_coachingNotes) ? null : _coachingNotes.Trim(),
                ReferenceUrl: string.IsNullOrWhiteSpace(_referenceUrl) ? null : _referenceUrl.Trim(),
                SortOrder: _sortOrder
            );

            var result = await CurriculumApi.AddTechniqueAsync(PlanId, WeekNumber, req);
            if (result.IsFailure)
            {
                _errorMessage = result.Error;
                return;
            }

            _title = "";
            _coachingNotes = null;
            _referenceUrl = null;
            _sortOrder++;

            await OnTechniqueAdded.InvokeAsync(result.Value);
            await Close();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FocusElementAsync(ElementReference element)
    {
        try
        {
            _interopModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-interop.js");
            await _interopModule.InvokeVoidAsync("focusElement", element);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_interopModule is not null)
        {
            try
            {
                await _interopModule.DisposeAsync();
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _interopModule = null;
        }
    }
}
