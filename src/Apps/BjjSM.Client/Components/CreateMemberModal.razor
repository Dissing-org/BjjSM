@inject IMemberApiClient MemberApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<ModalDialog IsOpen="IsOpen"
             OnClose="Close"
             Title="🥋 Opret nyt medlem"
             LightDismiss="false">
    <ChildContent>
        <form id="create-member-form" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div id="create-member-error" class="alert alert-danger py-2 small" role="alert">
                    @_errorMessage
                </div>
            }

            <div class="mb-3">
                <label for="create-member-first-name" class="form-label fw-bold text-dark small">Fornavn</label>
                <input id="create-member-first-name"
                       @ref="_firstNameInput"
                       type="text"
                       class="form-control"
                       @bind="_firstName"
                       placeholder="f.eks. Renzo"
                       autocomplete="given-name"
                       required
                       aria-invalid="@(_firstNameHasError ? "true" : null)"
                       aria-describedby="@(_firstNameHasError ? "create-member-error" : null)" />
            </div>

            <div class="mb-3">
                <label for="create-member-last-name" class="form-label fw-bold text-dark small">Efternavn</label>
                <input id="create-member-last-name"
                       @ref="_lastNameInput"
                       type="text"
                       class="form-control"
                       @bind="_lastName"
                       placeholder="f.eks. Gracie"
                       autocomplete="family-name"
                       required
                       aria-invalid="@(_lastNameHasError ? "true" : null)"
                       aria-describedby="@(_lastNameHasError ? "create-member-error" : null)" />
            </div>

            <div class="mb-3">
                <label for="create-member-email" class="form-label fw-bold text-dark small">E-mailadresse</label>
                <input id="create-member-email"
                       @ref="_emailInput"
                       type="email"
                       inputmode="email"
                       class="form-control"
                       @bind="_email"
                       placeholder="f.eks. renzo@akademi.dk"
                       autocomplete="email"
                       required
                       aria-invalid="@(_emailHasError ? "true" : null)"
                       aria-describedby="@(_emailHasError ? "create-member-error" : null)" />
            </div>

            <div class="mb-3">
                <label for="create-member-role" class="form-label fw-bold text-dark small">Rolle</label>
                <select id="create-member-role" class="form-select" @bind="_role">
                    <option value="@PractitionerRole.Student">Elev</option>
                    <option value="@PractitionerRole.Instructor">Instruktør</option>
                    <option value="@(PractitionerRole.Student | PractitionerRole.Instructor)">Instruktør og elev</option>
                </select>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="create-member-ladder" class="form-label fw-bold text-dark small">Bæltesystem</label>
                    <select id="create-member-ladder" class="form-select" @bind="_ladder" @bind:after="OnLadderChanged">
                        <option value="@BeltLadder.Adult">Voksen</option>
                        <option value="@BeltLadder.Kids">Børn</option>
                    </select>
                </div>
                <div class="col-6">
                    <label for="create-member-belt" class="form-label fw-bold text-dark small">Bæltegrad</label>
                    @if (_ladder == BeltLadder.Adult)
                    {
                        <select id="create-member-belt" class="form-select" @bind="_adultBelt">
                            @foreach (var belt in Enum.GetValues<AdultBelt>())
                            {
                                <option value="@belt">@FormatAdultBelt(belt)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="create-member-belt" class="form-select" @bind="_kidsBelt">
                            @foreach (var belt in Enum.GetValues<KidsBelt>())
                            {
                                <option value="@belt">@belt bælte</option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label for="create-member-stripes" class="form-label fw-bold text-dark small">Striber / grader: @_stripes</label>
                <input id="create-member-stripes" type="range" class="form-range" min="0" max="4" step="1" @bind="_stripes" />
                <div class="d-flex justify-content-between text-muted small px-1">
                    <span>0</span><span>1</span><span>2</span><span>3</span><span>4</span>
                </div>
            </div>
        </form>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="Close">Annuller</button>
        <button type="submit" form="create-member-form" class="btn btn-brand-primary" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Opretter...</span>
            }
            else
            {
                <span>Opret medlem</span>
            }
        </button>
    </FooterContent>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<MemberDto> OnMemberCreated { get; set; }

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private PractitionerRole _role = PractitionerRole.Student;
    private BeltLadder _ladder = BeltLadder.Adult;
    private AdultBelt _adultBelt = AdultBelt.White;
    private KidsBelt _kidsBelt = KidsBelt.White;
    private int _stripes = 0;
    private string? _errorMessage;
    private bool _firstNameHasError;
    private bool _lastNameHasError;
    private bool _emailHasError;
    private bool _isSaving;
    private ElementReference _firstNameInput;
    private ElementReference _lastNameInput;
    private ElementReference _emailInput;
    private IJSObjectReference? _interopModule;

    private static string FormatAdultBelt(AdultBelt belt) => belt switch
    {
        AdultBelt.White => "Hvidt bælte",
        AdultBelt.Blue => "Blåt bælte",
        AdultBelt.Purple => "Lilla bælte",
        AdultBelt.Brown => "Brunt bælte",
        AdultBelt.Black => "Sort bælte",
        AdultBelt.Coral => "Koralbælte",
        AdultBelt.Red => "Rødt bælte",
        _ => $"{belt} bælte"
    };

    private void OnLadderChanged()
    {
        _adultBelt = AdultBelt.White;
        _kidsBelt = KidsBelt.White;
        _stripes = 0;
    }

    private async Task Close()
    {
        _errorMessage = null;
        _firstNameHasError = false;
        _lastNameHasError = false;
        _emailHasError = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _firstNameHasError = string.IsNullOrWhiteSpace(_firstName);
        _lastNameHasError = string.IsNullOrWhiteSpace(_lastName);
        _emailHasError = string.IsNullOrWhiteSpace(_email);

        if (_firstNameHasError || _lastNameHasError || _emailHasError)
        {
            _errorMessage = "Fornavn, efternavn og e-mailadresse er påkrævet.";
            var firstInvalid = _firstNameHasError
                ? _firstNameInput
                : _lastNameHasError
                    ? _lastNameInput
                    : _emailInput;
            await FocusElementAsync(firstInvalid);
            return;
        }

        _isSaving = true;
        try
        {
            var req = new CreateMemberRequest(
                AcademyId: Guid.NewGuid(),
                FirstName: _firstName.Trim(),
                LastName: _lastName.Trim(),
                Email: _email.Trim(),
                Roles: _role,
                Ladder: _ladder,
                AdultBelt: _ladder == BeltLadder.Adult ? _adultBelt : null,
                KidsBelt: _ladder == BeltLadder.Kids ? _kidsBelt : null,
                Stripes: _stripes
            );

            var result = await MemberApi.CreateMemberAsync(req);
            if (result.IsFailure)
            {
                _errorMessage = result.Error;
                return;
            }

            _firstName = "";
            _lastName = "";
            _email = "";
            _stripes = 0;

            await OnMemberCreated.InvokeAsync(result.Value);
            await Close();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FocusElementAsync(ElementReference element)
    {
        try
        {
            _interopModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-interop.js");
            await _interopModule.InvokeVoidAsync("focusElement", element);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_interopModule is not null)
        {
            try
            {
                await _interopModule.DisposeAsync();
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _interopModule = null;
        }
    }
}
