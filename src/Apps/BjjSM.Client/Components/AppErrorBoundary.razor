@inherits ErrorBoundary

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="card border-0 shadow-sm p-4 bg-white my-4 mx-auto" style="max-width: 720px; border-left: 6px solid #20409A !important; border-top: 3px solid #FFEE00 !important; border-radius: 8px;">
        <div class="d-flex align-items-start gap-3">
            <div style="font-size: 2.2rem; line-height: 1;" aria-hidden="true">🥋</div>
            <div class="flex-grow-1">
                <h4 class="fw-bold text-dark m-0">Teknikken blev afbrudt</h4>
                <p class="text-muted mt-1 mb-3">
                    Der opstod en uventet fejl under indlæsning af denne visning. Din session og dine gemte data er stadig intakte.
                </p>

                <div class="d-flex gap-2 mb-3">
                    <button type="button" class="btn btn-brand-primary btn-sm px-3 fw-semibold" @onclick="Recover">
                        <span aria-hidden="true">🔄</span> Prøv igen
                    </button>
                    <a href="" class="btn btn-outline-secondary btn-sm px-3">
                        <span aria-hidden="true">⛩️</span> Tilbage til forsiden
                    </a>
                </div>

                <details class="bg-light p-2 rounded border small">
                    <summary class="fw-semibold text-secondary" style="cursor: pointer;">
                        Teknisk diagnostik
                    </summary>
                    <pre class="m-0 mt-2 text-danger small" style="white-space: pre-wrap; word-break: break-all;">@CurrentException.Message@if (!string.IsNullOrWhiteSpace(DebugStackTrace))
{
@("\n\n" + DebugStackTrace)
}</pre>
                </details>
            </div>
        </div>
    </div>
}

@code {
    private string? DebugStackTrace =>
#if DEBUG
        CurrentException?.StackTrace;
#else
        null;
#endif
}
