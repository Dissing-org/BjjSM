@using System.Globalization
@using BjjSM.Modules.Memberships.Domain

<div class="timeline-container">
    <div class="timeline-header">
        <h3 class="timeline-title">Gradueringshistorik</h3>
        <span class="timeline-badge">@Graduations.Count @(Graduations.Count == 1 ? "graduering" : "gradueringer")</span>
    </div>

    @if (!Graduations.Any())
    {
        <div class="timeline-empty">
            <p>Ingen bælte- eller stribegradueringer er registreret endnu. Startgraden er stadig aktiv.</p>
        </div>
    }
    else
    {
        <ol class="timeline-track" style="list-style: none; margin: 0;">
            @foreach (var graduation in Graduations.OrderByDescending(g => g.AwardedAt))
            {
                <li class="timeline-item" @key="graduation.Id">
                    <div class="timeline-marker" aria-hidden="true"></div>
                    <div class="timeline-content">
                        <div class="timeline-row">
                            <BjjBeltBadge Rank="@graduation.Rank" />
                            <time class="timeline-date" datetime="@graduation.AwardedAt.ToString("yyyy-MM-dd")">
                                @graduation.AwardedAt.ToString("dd. MMM yyyy", DaDkCulture)
                            </time>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(graduation.Notes))
                        {
                            <p class="timeline-notes">@graduation.Notes</p>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    private static readonly CultureInfo DaDkCulture = CultureInfo.GetCultureInfo("da-DK");

    [Parameter]
    public IReadOnlyCollection<GraduationDto> Graduations { get; set; } = [];
}
